msgstr "نص إضافي"

msgctxt "Languages::kwtsms.test_sms.suffix_help"
msgid "Optional, up to [max] characters."
msgstr "اختياري، حتى [max] حرفا."

msgctxt "Languages::kwtsms.test_sms.text"

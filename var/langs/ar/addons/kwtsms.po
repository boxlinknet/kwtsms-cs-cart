msgstr "تغييرات البائع"

msgctxt "Languages::kwtsms.integrations.mve.vendor_triggered.label"
msgid "Send the customer an SMS when a vendor changes an order status"
msgstr "أرسل رسالة للعميل عندما يغيّر البائع حالة الطلب"

msgctxt "Languages::kwtsms.integrations.mve.vendor_triggered.help"
msgid "A status already texted in the last 24 hours is never texted twice."
msgstr "الحالة التي أُرسلت رسالتها خلال آخر 24 ساعة لا تُرسل مرتين."


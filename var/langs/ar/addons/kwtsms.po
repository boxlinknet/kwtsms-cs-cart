msgstr "الرقم يتضمن رمز الدولة"

msgctxt "Languages::kwtsms.test_sms.intl_help"
msgid "If not ticked, a local number gets the default country code: [country]."
msgstr "إذا لم تحدد هذا الخيار، يضاف رمز الدولة الافتراضية إلى الرقم المحلي: [country]."


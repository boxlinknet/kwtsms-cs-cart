msgctxt "Languages::kwtsms.login.ok"
msgid "Logged in to kwtSMS."
msgstr "تم تسجيل الدخول إلى kwtSMS."

msgctxt "Languages::kwtsms.login.empty"
msgid "Enter both the API username and the API password."
msgstr "أدخل اسم مستخدم API وكلمة مرور API معا."

msgctxt "Languages::kwtsms.login.unreachable"
msgid "Could not reach kwtSMS. Check that this server can open https://www.kwtsms.com, then try again."
msgstr "تعذر الوصول إلى kwtSMS. تحقق من أن هذا الخادم يستطيع فتح https://www.kwtsms.com ثم حاول مرة أخرى."

msgctxt "Languages::kwtsms.login.save_failed"
msgid "kwtSMS accepted the login, but it could not be saved. Check the add-on log and try again."
msgstr "قبلت kwtSMS بيانات الدخول لكن تعذر حفظها. راجع سجل الإضافة وحاول مرة أخرى."

msgctxt "Languages::kwtsms.login.warn_username_long"
msgid "The API username is longer than 15 characters. Check that you copied the API user and nothing else."
msgstr "اسم مستخدم API أطول من 15 حرفا. تأكد من أنك نسخت مستخدم API فقط."

msgctxt "Languages::kwtsms.login.warn_password_long"
msgid "The API password is longer than 30 characters. Check that you copied the API password and nothing else."
msgstr "كلمة مرور API أطول من 30 حرفا. تأكد من أنك نسخت كلمة مرور API فقط."

msgctxt "Languages::kwtsms.login.warn_username_digits"
msgid "The API username is all digits. It is usually not your mobile number. Use the API user from kwtsms.com > Account > API."
msgstr "اسم مستخدم API كله أرقام. غالبا لا يكون رقم جوالك. استخدم مستخدم API من kwtsms.com > الحساب > API."

msgctxt "Languages::kwtsms.cron.failed"
msgid "kwtSMS cron run failed: [details]"
msgstr "فشل تشغيل مهمة kwtSMS المجدولة: [details]"

msgctxt "Languages::kwtsms.alert.sender_removed.title"
msgid "Sender ID removed from your kwtSMS account"
msgstr "تمت إزالة معرف المرسل من حساب kwtSMS"

msgctxt "Languages::kwtsms.alert.sender_removed.text"
msgid "The Sender ID [sender] is no longer on your kwtSMS account, so SMS are paused. Select another Sender ID in the kwtSMS settings."
msgstr "معرف المرسل [sender] لم يعد موجودا في حساب kwtSMS، لذلك توقف إرسال الرسائل. اختر معرف مرسل آخر من إعدادات kwtSMS."

msgctxt "Languages::kwtsms.alert.sender_banned.title"
msgid "kwtSMS banned your Sender ID"
msgstr "حظرت kwtSMS معرف المرسل"

msgctxt "Languages::kwtsms.alert.sender_banned.text"
msgid "kwtSMS banned the Sender ID [sender], so SMS are paused. Select another Sender ID in the kwtSMS settings."
msgstr "حظرت kwtSMS معرف المرسل [sender]، لذلك توقف إرسال الرسائل. اختر معرف مرسل آخر من إعدادات kwtSMS."

msgctxt "Languages::kwtsms.alert.test_mode.title"
msgid "SMS test mode is on"
msgstr "وضع اختبار الرسائل مفعل"


msgctxt "Languages::kwtsms.status.B"
msgid "Backordered"
msgstr "قيد التوفير"

msgctxt "Languages::kwtsms.status.C"
msgid "Complete"
msgstr "مكتمل"

msgctxt "Languages::kwtsms.status.D"
msgid "Declined"
msgstr "مرفوض"

msgctxt "Languages::kwtsms.status.F"
msgid "Failed"
msgstr "فشل"

msgctxt "Languages::kwtsms.status.I"
msgid "Canceled"
msgstr "ملغي"

msgctxt "Languages::kwtsms.status.O"
msgid "Open"
msgstr "مفتوح"

msgctxt "Languages::kwtsms.status.P"
msgid "Paid"
msgstr "مدفوع"

msgctxt "Languages::kwtsms.status.Y"

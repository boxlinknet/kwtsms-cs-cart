msgid "To turn this on, enter the code we send to the mobile number on your account:"
msgstr "لتفعيل هذه الميزة، أدخل الرمز الذي نرسله إلى رقم الجوال في حسابك:"

msgctxt "Languages::kwtsms.twofa.profile_disable_hint"
msgid "We will send a code to your current number. Enter it to turn this off."
msgstr "سنرسل رمزا إلى رقمك الحالي. أدخله لإيقاف هذه الميزة."

msgctxt "Languages::kwtsms.twofa.profile_send"
msgid "Send me a code"
msgstr "أرسل لي رمزا"

msgctxt "Languages::kwtsms.twofa.turn_on"
msgid "Turn on"
msgstr "تفعيل"

msgctxt "Languages::kwtsms.twofa.turn_off"
msgid "Turn off"
msgstr "إيقاف"

msgctxt "Languages::kwtsms.twofa.turned_on"
msgid "SMS code at sign-in is on."
msgstr "تم تفعيل رمز الرسالة عند تسجيل الدخول."

msgctxt "Languages::kwtsms.twofa.turned_off"
msgid "SMS code at sign-in is off."
msgstr "تم إيقاف رمز الرسالة عند تسجيل الدخول."

msgctxt "Languages::kwtsms.twofa.no_phone"
msgid "Add a mobile number to your account first."
msgstr "أضف رقم جوال إلى حسابك أولا."

msgctxt "Languages::kwtsms.twofa.no_phone_admin"
msgid "Add a mobile number in the Phone field of your account first."
msgstr "أضف رقم جوال في حقل الهاتف بحسابك أولا."

msgctxt "Languages::kwtsms.twofa.in_use"
msgid "This number belongs to another account."
msgstr "هذا الرقم يخص حسابا آخر."

msgctxt "Languages::kwtsms.twofa.required"
msgid "Your store requires an SMS code at sign-in. You cannot turn it off."
msgstr "يشترط متجرك رمزا نصيا عند تسجيل الدخول. لا يمكنك إيقافه."

msgctxt "Languages::kwtsms.twofa.back_to_profile"
msgid "Back to my profile"
msgstr "العودة إلى ملفي الشخصي"

msgctxt "Languages::kwtsms.settings.twofa_title"
msgid "Two-step sign-in"
msgstr "تسجيل الدخول بخطوتين"

msgctxt "Languages::kwtsms.settings.twofa_help"
msgid "Ask for an SMS code after the password. Every option is off until you turn it on."
msgstr "اطلب رمزا نصيا بعد كلمة المرور. كل الخيارات متوقفة حتى تفعلها."

msgctxt "Languages::kwtsms.settings.field.twofa_customers"
msgid "Two-step sign-in for customers"
msgstr "تسجيل الدخول بخطوتين للعملاء"

msgctxt "Languages::kwtsms.settings.field.twofa_vendors"
msgid "Two-step sign-in for vendors"
msgstr "تسجيل الدخول بخطوتين للتجار"

msgctxt "Languages::kwtsms.settings.field.twofa_admins"
msgid "Two-step sign-in for administrators"
msgstr "تسجيل الدخول بخطوتين للمديرين"

msgctxt "Languages::kwtsms.settings.twofa_off"
msgid "Off"
msgstr "متوقف"

msgctxt "Languages::kwtsms.settings.twofa_optional"
msgid "Optional: each user turns it on for themselves"
msgstr "اختياري: يفعله كل مستخدم لنفسه"

msgctxt "Languages::kwtsms.settings.twofa_optional_customers"
msgid "Optional: each customer turns it on for themselves"
msgstr "اختياري: يفعله كل عميل لنفسه"

msgctxt "Languages::kwtsms.settings.twofa_required"
msgid "Required for every user of this type"
msgstr "إلزامي لكل مستخدم من هذا النوع"

msgctxt "Languages::kwtsms.settings.twofa_admins_help"
msgid "Required: every administrator enters an SMS code after the password. Turning it on asks for a code sent to your own mobile number. To use it, first save Optional so codes can be sent. Break-glass: add define('KWTSMS_2FA_OFF', true); to config.local.php to turn every second step off."
msgstr "الإلزامي: يدخل كل مدير رمز SMS بعد كلمة المرور. يتطلب تفعيله رمزا يُرسل إلى رقم جوالك. لاستخدامه احفظ الخيار الاختياري أولا حتى يمكن إرسال الرموز. للطوارئ: أضف define('KWTSMS_2FA_OFF', true); إلى ملف config.local.php لإيقاف كل خطوة ثانية."

msgctxt "Languages::kwtsms.settings.twofa_break_glass"
msgid "KWTSMS_2FA_OFF is set in config.local.php: no sign-in is held for a code. Remove the line to use the second step again."
msgstr "الثابت KWTSMS_2FA_OFF مضبوط في config.local.php: لا يُحجز أي تسجيل دخول لطلب رمز. احذف السطر لإعادة استخدام الخطوة الثانية."


# 2026-11-05 07:31 +03: Task M2.2b (SafatMall B3, P3-52), task 596. Backup codes, the guard of required, reset, alerts.
msgctxt "Languages::kwtsms.twofa.backup_link"
msgid "Use a backup code instead"
msgstr "استخدم رمزا احتياطيا بدلا من ذلك"

msgctxt "Languages::kwtsms.twofa.sms_link"
msgid "Use the SMS code instead"
msgstr "استخدم رمز SMS بدلا من ذلك"

msgctxt "Languages::kwtsms.twofa.backup_title"
msgid "Sign in with a backup code"
msgstr "الدخول برمز احتياطي"

msgctxt "Languages::kwtsms.twofa.backup_intro"
msgid "Type one of your backup codes. Each code works once."
msgstr "اكتب أحد رموزك الاحتياطية. كل رمز يعمل مرة واحدة."

msgctxt "Languages::kwtsms.twofa.backup_label"
msgid "Backup code"
msgstr "الرمز الاحتياطي"

msgctxt "Languages::kwtsms.twofa.backup_none"
msgid "This account has no backup codes. Use the SMS code."
msgstr "لا توجد رموز احتياطية لهذا الحساب. استخدم رمز SMS."

msgctxt "Languages::kwtsms.twofa.backup_low"
msgid "You have [n] backup codes left. Create a new set on your two-step sign-in page."
msgstr "بقي لديك [n] من الرموز الاحتياطية. أنشئ مجموعة جديدة من صفحة الدخول بخطوتين."

msgctxt "Languages::kwtsms.twofa.backup_new"
msgid "New backup codes created. The old ones no longer work."
msgstr "تم إنشاء رموز احتياطية جديدة. الرموز القديمة لم تعد تعمل."

msgctxt "Languages::kwtsms.twofa.backup_codes_title"
msgid "Your backup codes"
msgstr "رموزك الاحتياطية"

msgctxt "Languages::kwtsms.twofa.backup_codes_intro"
msgid "Save these codes somewhere safe, for example in a password manager. Each code works once, in place of an SMS code. They are shown only now."
msgstr "احفظ هذه الرموز في مكان آمن، مثلا في مدير كلمات المرور. كل رمز يعمل مرة واحدة بدلا من رمز SMS. تظهر الآن فقط."

msgctxt "Languages::kwtsms.twofa.backup_codes_continue"
msgid "I saved them. Continue"
msgstr "حفظتها. متابعة"

msgctxt "Languages::kwtsms.twofa.backup_codes_back"
msgid "I saved them. Back to my two-step sign-in"
msgstr "حفظتها. العودة إلى الدخول بخطوتين"

msgctxt "Languages::kwtsms.twofa.backup_section"
msgid "Backup codes"
msgstr "الرموز الاحتياطية"

msgctxt "Languages::kwtsms.twofa.backup_remaining"
msgid "Backup codes left: [n]"
msgstr "الرموز الاحتياطية المتبقية: [n]"

msgctxt "Languages::kwtsms.twofa.backup_regen_hint"
msgid "Send yourself a code, type it, and create a new set. The old codes stop working at once."
msgstr "أرسل لنفسك رمزا واكتبه ثم أنشئ مجموعة جديدة. تتوقف الرموز القديمة فورا."

msgctxt "Languages::kwtsms.twofa.backup_create"
msgid "Create new backup codes"
msgstr "إنشاء رموز احتياطية جديدة"

msgctxt "Languages::kwtsms.twofa.reset_label"
msgid "Two-step sign-in"
msgstr "الدخول بخطوتين"

msgctxt "Languages::kwtsms.twofa.reset_state_on"
msgid "On for this account"
msgstr "مفعّل لهذا الحساب"

msgctxt "Languages::kwtsms.twofa.reset_button"
msgid "Reset the second step"
msgstr "إعادة ضبط الخطوة الثانية"

msgctxt "Languages::kwtsms.twofa.reset_confirm"
msgid "Reset the SMS code sign-in of this account? Its backup codes are deleted and it must set the second step up again."
msgstr "إعادة ضبط الدخول برمز SMS لهذا الحساب؟ ستُحذف رموزه الاحتياطية وعليه إعداد الخطوة الثانية من جديد."

msgctxt "Languages::kwtsms.twofa.reset_done"
msgid "The second step of this account was reset."
msgstr "تمت إعادة ضبط الخطوة الثانية لهذا الحساب."

msgctxt "Languages::kwtsms.twofa.reset_self"
msgid "You can't reset your own second step here. Ask another root administrator, or run the command on the server."
msgstr "لا يمكنك إعادة ضبط خطوتك الثانية من هنا. اطلب ذلك من مدير رئيسي آخر أو شغّل الأمر على الخادم."

msgctxt "Languages::kwtsms.twofa.reset_failed"
msgid "The second step could not be reset."
msgstr "تعذّرت إعادة ضبط الخطوة الثانية."

msgctxt "Languages::kwtsms.settings.twofa_proof_title"
msgid "Before you require it"
msgstr "قبل جعله إلزاميا"

msgctxt "Languages::kwtsms.settings.twofa_proof_intro"
msgid "Required makes every administrator enter an SMS code after the password. To be sure you can receive it yourself, send a code to your own mobile number and type it here when you save."
msgstr "الإلزامي يجعل كل مدير يدخل رمز SMS بعد كلمة المرور. للتأكد من أنك تستطيع استلامه بنفسك، أرسل رمزا إلى رقم جوالك واكتبه هنا عند الحفظ."

msgctxt "Languages::kwtsms.settings.twofa_proof_send"
msgid "Send me a code"
msgstr "أرسل لي رمزا"

msgctxt "Languages::kwtsms.settings.twofa_proof_label"
msgid "Code sent to your mobile"
msgstr "الرمز المرسل إلى جوالك"

msgctxt "Languages::kwtsms.settings.twofa_without_title"
msgid "Administrators without a mobile number"
msgstr "مديرون بلا رقم جوال"

msgctxt "Languages::kwtsms.settings.twofa_without_note"
msgid "These administrators cannot sign in until a mobile number is added to their account:"
msgstr "لا يستطيع هؤلاء المديرون الدخول حتى يُضاف رقم جوال إلى حساباتهم:"

msgctxt "Languages::kwtsms.settings.twofa_without_ack"
msgid "I understand that the administrators listed above cannot sign in until a number is added."
msgstr "أفهم أن المديرين المذكورين أعلاه لا يستطيعون الدخول حتى يُضاف رقم."

msgctxt "Languages::kwtsms.settings.twofa_req.sent"
msgid "A code was sent to your mobile number. Type it in the box and save."
msgstr "أُرسل رمز إلى رقم جوالك. اكتبه في الخانة ثم احفظ."

msgctxt "Languages::kwtsms.settings.twofa_req.not_root"
msgid "Only a root administrator can require a code for administrators."
msgstr "المدير الرئيسي فقط يستطيع جعل الرمز إلزاميا للمديرين."

msgctxt "Languages::kwtsms.settings.twofa_req.no_mobile"
msgid "Add a mobile number to your own account first. You need it to receive the code."
msgstr "أضف رقم جوال إلى حسابك أولا. تحتاجه لاستلام الرمز."

msgctxt "Languages::kwtsms.settings.twofa_req.ack_missing"
msgid "Some administrators have no mobile number. Tick the box to confirm they cannot sign in, or add their numbers first. Nothing was changed."
msgstr "بعض المديرين بلا رقم جوال. ضع علامة في الخانة لتأكيد أنهم لن يستطيعوا الدخول، أو أضف أرقامهم أولا. لم يتغير شيء."

msgctxt "Languages::kwtsms.settings.twofa_req.proof_missing"
msgid "Send yourself a code and type it to require it for administrators. Nothing was changed."
msgstr "أرسل لنفسك رمزا واكتبه لجعله إلزاميا للمديرين. لم يتغير شيء."

msgctxt "Languages::kwtsms.settings.twofa_req.proof_malformed"
msgid "Type the 6 digits of the code. Nothing was changed."
msgstr "اكتب أرقام الرمز الستة. لم يتغير شيء."

msgctxt "Languages::kwtsms.settings.twofa_req.proof_wrong"
msgid "The code is not correct. Nothing was changed."
msgstr "الرمز غير صحيح. لم يتغير شيء."

msgctxt "Languages::kwtsms.settings.twofa_req.proof_locked"
msgid "Too many wrong codes. Wait a few minutes and try again. Nothing was changed."
msgstr "محاولات خاطئة كثيرة. انتظر بضع دقائق ثم أعد المحاولة. لم يتغير شيء."

msgctxt "Languages::kwtsms.settings.twofa_req.proof_expired"
msgid "The code has expired or was not sent. Send a new one. Nothing was changed."
msgstr "انتهت صلاحية الرمز أو لم يُرسل. أرسل رمزا جديدا. لم يتغير شيء."

msgctxt "Languages::kwtsms.settings.twofa_req.error"
msgid "The code could not be checked, so nothing was changed. Try again."
msgstr "تعذّر التحقق من الرمز فلم يتغير شيء. أعد المحاولة."

msgctxt "Languages::kwtsms.settings.twofa_req.unavailable"
msgid "A code can't be sent right now. If every two-step option is off, save Optional first. Check the SMS status on the Dashboard."
msgstr "تعذّر إرسال الرمز الآن. إذا كانت كل خيارات الخطوتين متوقفة فاحفظ الخيار الاختياري أولا. راجع حالة الرسائل في لوحة المعلومات."

msgctxt "Languages::kwtsms.settings.twofa_req.wait"
msgid "A code was sent a moment ago. Wait a little before asking for another."
msgstr "أُرسل رمز قبل لحظات. انتظر قليلا قبل طلب رمز آخر."

msgctxt "Languages::kwtsms.alert.twofa_degraded.title"
msgid "Your last root administrator signs in without a code"
msgstr "آخر مدير رئيسي يدخل بلا رمز"

msgctxt "Languages::kwtsms.alert.twofa_degraded.text"
msgid "A root administrator signed in with the password only, because the account has no mobile number and no other root administrator has two-step sign-in. Add a mobile number on the profile page, then sign in again to set up the SMS code."
msgstr "دخل مدير رئيسي بكلمة المرور فقط لأن حسابه بلا رقم جوال ولا يوجد مدير رئيسي آخر مفعّل عنده الدخول بخطوتين. أضف رقم جوال في صفحة الملف الشخصي ثم سجّل الدخول من جديد لإعداد رمز SMS."

msgctxt "Languages::kwtsms.alert.twofa_disabled_by_config.title"
msgid "Two-step sign-in is switched off in the configuration"
msgstr "الدخول بخطوتين متوقف من ملف الإعدادات"

msgctxt "Languages::kwtsms.alert.twofa_disabled_by_config.text"
msgid "KWTSMS_2FA_OFF is set in config.local.php, so no sign-in asks for an SMS code. Remove the line once the problem is fixed."
msgstr "الثابت KWTSMS_2FA_OFF مضبوط في config.local.php لذلك لا يطلب أي دخول رمز SMS. احذف السطر بعد إصلاح المشكلة."

msgctxt "Languages::kwtsms.alert.twofa_reset.title"
msgid "A second step was reset"
msgstr "أُعيد ضبط خطوة ثانية"

msgctxt "Languages::kwtsms.alert.twofa_reset.text"
msgid "A root administrator cleared the two-step sign-in and the backup codes of account [user]. The account has to set it up again."
msgstr "مسح مدير رئيسي الدخول بخطوتين والرموز الاحتياطية للحساب [user]. على الحساب إعداده من جديد."

msgctxt "Languages::kwtsms.alert.twofa_backup_guessing.title"
msgid "Backup codes are being guessed"
msgstr "يجري تخمين الرموز الاحتياطية"

msgctxt "Languages::kwtsms.alert.twofa_backup_guessing.text"
msgid "Ten wrong backup codes were entered for account [user] within an hour. If this was not the owner, reset the account's two-step sign-in and change its password."
msgstr "أُدخل عشرة رموز احتياطية خاطئة للحساب [user] خلال ساعة. إن لم يكن المالك، فأعد ضبط الدخول بخطوتين لهذا الحساب وغيّر كلمة مروره."

msgctxt "Languages::kwtsms.settings.twofa_vend_without_title"
msgid "Vendor administrators without a mobile number"
msgstr "مديرو بائعين بلا رقم جوال"

msgctxt "Languages::kwtsms.settings.twofa_vend_without_note"
msgid "These vendor administrators cannot sign in until a mobile number is added to their account, or Vendors is switched back to Optional:"
msgstr "لا يستطيع مديرو البائعين هؤلاء الدخول حتى يُضاف رقم جوال إلى حساباتهم، أو يُعاد خيار البائعين إلى اختياري:"

msgctxt "Languages::kwtsms.settings.twofa_vend_without_ack"
msgid "I understand that the vendor administrators listed above cannot sign in until a number is added."
msgstr "أفهم أن مديري البائعين المذكورين أعلاه لا يستطيعون الدخول حتى يُضاف رقم."

msgctxt "Languages::kwtsms.settings.twofa_vend.ack_missing"
msgid "Some vendor administrators have no mobile number. Tick the box to confirm they cannot sign in, or add their numbers first. Nothing was changed."
msgstr "بعض مديري البائعين بلا رقم جوال. ضع علامة في الخانة لتأكيد أنهم لن يستطيعوا الدخول، أو أضف أرقامهم أولا. لم يتغير شيء."

msgctxt "Languages::kwtsms.settings.twofa_vend.error"
msgid "Required for vendors could not be checked, so nothing was changed. Try again."
msgstr "تعذّر التحقق من خيار الإلزام للبائعين فلم يتغير شيء. أعد المحاولة."

# 2026-11-05 16:38 +03: Task M2.3 (SafatMall B4, P3-53), task 596. Recovery by an SMS code: the login form link, the page, the
# failure text and the Settings field.
msgctxt "Languages::kwtsms.recover.link"
msgid "Forgot your password? Use your mobile number"
msgstr "نسيت كلمة المرور؟ استخدم رقم جوالك"

msgctxt "Languages::kwtsms.recover.title"
msgid "Recover your account with your mobile number"
msgstr "استعادة حسابك برقم الجوال"

msgctxt "Languages::kwtsms.recover.intro"
msgid "Enter your mobile number and ask for a code, then type the code below. You can then choose a new password."
msgstr "أدخل رقم جوالك واطلب رمزاً، ثم اكتب الرمز أدناه. بعدها تستطيع اختيار كلمة مرور جديدة."

msgctxt "Languages::kwtsms.recover.submit"
msgid "Verify and continue"
msgstr "تحقق ومتابعة"

msgctxt "Languages::kwtsms.recover.email_link"
msgid "Reset your password by email instead"
msgstr "إعادة تعيين كلمة المرور بالبريد الإلكتروني بدلاً من ذلك"

msgctxt "Languages::kwtsms.recover.failed"
msgid "We could not start the recovery. Try again in a few minutes."
msgstr "تعذّر بدء الاستعادة. حاول مرة أخرى بعد دقائق."

msgctxt "Languages::kwtsms.settings.field.recover_code"
msgid "Recovery by an SMS code"
msgstr "الاستعادة برمز SMS"

msgctxt "Languages::kwtsms.settings.recover_code_label"
msgid "Let customers recover their account with a verified mobile number and an SMS code"
msgstr "السماح للعملاء باستعادة حساباتهم برقم جوال متحقق منه ورمز SMS"

msgctxt "Languages::kwtsms.settings.recover_code_help"
msgid "When on, the login form links to a page where a customer asks for a code on a mobile number and then sets a new password. Only active customer accounts whose number was verified by a code can use it. The page never says whether a number has an account. The email reset stays as it is."
msgstr "عند التفعيل يحتوي نموذج تسجيل الدخول على رابط إلى صفحة يطلب فيها العميل رمزاً على رقم جوال ثم يعيّن كلمة مرور جديدة. يستطيع استخدامها فقط أصحاب حسابات العملاء النشطة التي تم التحقق من رقمها برمز. لا تذكر الصفحة أبداً ما إذا كان الرقم مرتبطاً بحساب. تبقى إعادة التعيين بالبريد الإلكتروني كما هي."

# 2026-11-05 20:52 +03: Task M2.4 (SafatMall B6, P3-54), task 596. The SMS code before an order is placed.
msgctxt "Languages::kwtsms.checkout.code_required"
msgid "Verify your mobile number with the SMS code to place your order."
msgstr "تحقق من رقم جوالك برمز SMS لإتمام طلبك."

msgctxt "Languages::kwtsms.checkout.field_label"
msgid "SMS code for this order"
msgstr "رمز SMS لهذا الطلب"

# 2026-11-06 03:09 +03: Task M2.4 fix 1 (security review I2), task 596. A customer's own API order is asked for the checkout code.
msgctxt "Languages::kwtsms.checkout.api_code_required"
msgid "This order needs a verified mobile number. A customer account can place orders through the API only when the phone number of the order is the verified phone number of the account. Verify the number in the store first, or place the order in the store."
msgstr "يحتاج هذا الطلب إلى رقم جوال موثّق. لا يستطيع حساب العميل إنشاء طلبات عبر واجهة API إلا إذا كان رقم هاتف الطلب هو رقم الجوال الموثّق للحساب. وثّق الرقم في المتجر أولاً أو أنشئ الطلب من المتجر."

msgctxt "Languages::kwtsms.settings.checkout_api_warning"
msgid "The REST API for storefronts (add-on storefront_rest_api) is active. Customers can place orders through it with their own token, so it is covered by this switch: such an order is accepted only when its phone number is the verified phone number of the customer's account. Orders placed through the API with an administrator or vendor key are not asked."
msgstr "واجهة REST للمتجر (الإضافة storefront_rest_api) مفعّلة. يستطيع العملاء إنشاء طلبات عبرها برمزهم الخاص، لذلك يشملها هذا الخيار: لا يُقبل مثل هذا الطلب إلا إذا كان رقم هاتفه هو رقم الجوال الموثّق لحساب العميل. أما الطلبات المنشأة عبر الواجهة بمفتاح مدير أو بائع فلا يُطلب لها رمز."

msgctxt "Languages::kwtsms.settings.field.checkout_code"
msgid "SMS code before an order"
msgstr "رمز SMS قبل إتمام الطلب"

msgctxt "Languages::kwtsms.settings.checkout_off"
msgid "Off"
msgstr "متوقف"

msgctxt "Languages::kwtsms.settings.checkout_all"
msgid "Every order"
msgstr "كل الطلبات"

msgctxt "Languages::kwtsms.settings.checkout_guest"
msgid "Orders of guests who are not signed in"
msgstr "طلبات الزوار غير المسجلين"

msgctxt "Languages::kwtsms.settings.checkout_cod"
msgid "Cash on delivery orders only"
msgstr "طلبات الدفع عند الاستلام فقط"

msgctxt "Languages::kwtsms.settings.checkout_code_help"
msgid "The customer asks for a code on the mobile number of the order and types it on the checkout page before the order is placed. A code works for that number and that browser session, and for one order. A signed-in customer whose account number was verified by a code is not asked. Paying an order again with another payment is asked too. Orders placed in the admin panel, through the API with an administrator or vendor key, or by the payment provider of the payment in the cart when it returns to the store are never asked. An order a customer places through the API with their own token is accepted only with their verified account number. In the cash on delivery mode the code is for the shipping phone when one is entered (the number the courier calls)."
msgstr "يطلب العميل رمزاً على رقم جوال الطلب ويكتبه في صفحة إتمام الطلب قبل تسجيل الطلب. يصلح الرمز لذلك الرقم ولجلسة المتصفح نفسها ولطلب واحد. لا يُطلب الرمز من عميل مسجل الدخول إذا كان رقم حسابه قد تم التحقق منه برمز. يُطلب الرمز أيضاً عند إعادة دفع طلب بوسيلة دفع أخرى. لا تُطلب الرموز للطلبات التي تُسجَّل من لوحة الإدارة أو عبر واجهة API بمفتاح مدير أو بائع أو من مزود دفع وسيلة الدفع الموجودة في السلة عندما يعيد العميل إلى المتجر. أما الطلب الذي يُنشئه العميل بنفسه عبر واجهة API فلا يُقبل إلا برقم حسابه الموثّق. في وضع الدفع عند الاستلام يكون الرمز لرقم هاتف الشحن إذا أُدخل (الرقم الذي يتصل به المندوب)."

msgctxt "Languages::kwtsms.settings.field.checkout_cod_payments"
msgid "Cash on delivery payments"
msgstr "طرق الدفع عند الاستلام"

msgctxt "Languages::kwtsms.settings.checkout_cod_payments_help"
msgid "Used by the cash on delivery mode: only an order paid with a ticked payment is asked for a code. A payment that uses the cash on delivery template of the store is marked."
msgstr "تُستخدم في وضع الدفع عند الاستلام: يُطلب الرمز فقط للطلب المدفوع بإحدى الطرق المحددة. وتُعلَّم طريقة الدفع التي تستخدم قالب الدفع عند الاستلام في المتجر."

msgctxt "Languages::kwtsms.settings.checkout_cod_marked"
msgid "cash on delivery"
msgstr "الدفع عند الاستلام"

msgctxt "Languages::kwtsms.settings.checkout_cod_none"
msgid "Cash on delivery mode with no payment selected: no order is checked."
msgstr "وضع الدفع عند الاستلام دون تحديد أي طريقة دفع: لا يُفحص أي طلب."

msgctxt "Languages::kwtsms.settings.checkout_no_phone_field"
msgid "The checkout shows no phone field. With this switch on, every order that needs a code is refused because no number can be verified. Add a phone field under Administration > Profile fields first."
msgstr "لا تعرض صفحة إتمام الطلب حقل هاتف. مع تفعيل هذا الخيار يُرفض كل طلب يحتاج إلى رمز لأنه لا يمكن التحقق من أي رقم. أضف حقل هاتف أولاً من الإدارة > حقول الملف الشخصي."

msgctxt "Languages::kwtsms.settings.field.vendor_phone_self_verify"
msgid "Vendor number confirmation"
msgstr "تأكيد رقم التاجر"

msgctxt "Languages::kwtsms.settings.vendor_phone_self_verify_label"
msgid "Vendors confirm their SMS number with a code"
msgstr "يؤكد التجار رقم رسائلهم برمز"

msgctxt "Languages::kwtsms.settings.vendor_phone_self_verify_help"
msgid "Each vendor gets a page in its panel that sends a code to the company phone. A confirmed number receives the vendor's order SMS. You can still approve a number yourself on the Vendor SMS page, and a changed company phone has to be confirmed again."
msgstr "يحصل كل تاجر على صفحة في لوحته ترسل رمزاً إلى هاتف الشركة، ويستلم الرقم المؤكد رسائل طلبات التاجر. يمكنك دائماً الموافقة على رقم بنفسك من صفحة رسائل التجار، وإذا تغير هاتف الشركة وجب تأكيده من جديد."

msgctxt "Languages::kwtsms.settings.vendor_phone_self_verify_mve_only"
msgid "Vendor accounts exist in Multi-Vendor only. The vendor number confirmation was not turned on."
msgstr "حسابات التجار موجودة في نسخة تعدد التجار فقط، لذلك لم يتم تفعيل تأكيد رقم التاجر."


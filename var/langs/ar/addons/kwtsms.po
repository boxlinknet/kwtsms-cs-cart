msgstr "لم يحفظ: [field]. [reason]"

msgctxt "Languages::kwtsms.settings.ack_required"
msgid "Test mode is still on. To turn it off while KWT-SMS is the Sender ID, tick the confirmation under Test mode."
msgstr "ما زال وضع الاختبار مفعلا. لإيقافه بينما KWT-SMS هو معرف المرسل، حدد خانة التأكيد أسفل وضع الاختبار."

msgctxt "Languages::kwtsms.settings.enable_refused"

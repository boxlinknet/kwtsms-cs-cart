msgstr "ما زالت الرسائل متوقفة. [reason]"

msgctxt "Languages::kwtsms.settings.sync_failed"
msgid "The sync with kwtSMS failed. The add-on keeps its saved data and tries again later."
msgstr "فشلت المزامنة مع kwtSMS. تحتفظ الإضافة ببياناتها المحفوظة وتعيد المحاولة لاحقا."

msgctxt "Languages::kwtsms.settings.synced"
msgid "Synced with kwtSMS"
msgstr "تمت المزامنة مع kwtSMS"

msgctxt "Languages::kwtsms.settings.disconnected"
msgid "Disconnected from kwtSMS. SMS are off until you log in again."
msgstr "تم قطع الاتصال بـ kwtSMS. الرسائل متوقفة حتى تسجل الدخول مرة أخرى."

msgctxt "Languages::kwtsms.settings.disconnect_failed"
msgid "Disconnect didn't finish and some settings weren't cleared. Check the add-on log, then try again."
msgstr "لم يكتمل قطع الاتصال ولم تمسح بعض الإعدادات. راجع سجل الإضافة ثم حاول مرة أخرى."

msgctxt "Languages::kwtsms.settings.balance_refreshed"
msgid "Balance updated: [balance] credits"
msgstr "تم تحديث الرصيد: [balance] نقطة"

msgctxt "Languages::kwtsms.settings.balance_not_refreshed"
msgid "The balance couldn't be updated. Check the add-on log, then try again."
msgstr "تعذر تحديث الرصيد. راجع سجل الإضافة ثم حاول مرة أخرى."

msgctxt "Languages::kwtsms.settings.resumed"
msgid "kwtSMS answers again. Sending resumed."
msgstr "تستجيب kwtSMS مرة أخرى. تم استئناف الإرسال."

msgctxt "Languages::kwtsms.settings.not_suspended"
msgid "Sending isn't paused."
msgstr "الإرسال غير متوقف."

msgctxt "Languages::kwtsms.settings.still_suspended"
msgid "Sending is still paused. [reason]"
msgstr "ما زال الإرسال متوقفا. [reason]"

msgctxt "Languages::kwtsms.settings.resumed_daily_cap"
msgid "Sending resumed. Today's count starts again now."
msgstr "تم استئناف الإرسال. يبدأ عد اليوم من جديد الآن."

msgctxt "Languages::kwtsms.settings.key_regenerated"
msgid "New cron key saved. Update your scheduler with it."
msgstr "تم حفظ مفتاح المهمة الجديد. حدث المجدول به."

msgctxt "Languages::kwtsms.settings.key_not_regenerated"
msgid "The new cron key couldn't be saved. The old key still works. Check the add-on log."
msgstr "تعذر حفظ مفتاح المهمة الجديد. ما زال المفتاح القديم يعمل. راجع سجل الإضافة."

msgctxt "Languages::kwtsms.settings.failed"
msgid "This action couldn't be completed. Check the add-on log, then try again."
msgstr "تعذر إكمال هذا الإجراء. راجع سجل الإضافة ثم حاول مرة أخرى."

msgctxt "Languages::kwtsms.reason.no_credentials"

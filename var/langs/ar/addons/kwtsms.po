msgctxt "Languages::kwtsms.conditions.err_row"
msgid "Nothing changed. That row doesn't exist."
msgstr "لم يتغير شيء. هذا الصف غير موجود."

msgctxt "Languages::kwtsms.conditions.err_min_total"
msgid "Nothing changed. The minimum total must be a number such as 5 or 5.250 (up to 10 digits and 3 decimals)."
msgstr "لم يتغير شيء. يجب أن يكون الحد الأدنى رقماً مثل 5 أو 5.250 (حتى 10 أرقام و3 خانات عشرية)."

msgctxt "Languages::kwtsms.conditions.err_payment"

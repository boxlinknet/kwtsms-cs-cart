msgstr "سجل الدخول إلى kwtSMS أولا."

msgctxt "Languages::kwtsms.reason.relogin_required"
msgid "Log in to kwtSMS again."
msgstr "سجل الدخول إلى kwtSMS مرة أخرى."

msgctxt "Languages::kwtsms.reason.not_logged_in"
msgid "Log in to kwtSMS first."
msgstr "سجل الدخول إلى kwtSMS أولا."

msgctxt "Languages::kwtsms.reason.no_sender_ids"
msgid "Your kwtSMS account has no Sender ID yet."
msgstr "لا يوجد معرف مرسل في حساب kwtSMS بعد."

msgctxt "Languages::kwtsms.reason.sender_not_in_list"
msgid "Choose a Sender ID."
msgstr "اختر معرف المرسل."

msgctxt "Languages::kwtsms.reason.sender_banned"
msgid "kwtSMS banned this Sender ID. Choose another one."
msgstr "حظرت kwtSMS معرف المرسل هذا. اختر معرفا آخر."

msgctxt "Languages::kwtsms.reason.unknown_country"
msgid "Choose a country from the list."
msgstr "اختر دولة من القائمة."

msgctxt "Languages::kwtsms.reason.sender_unknown"

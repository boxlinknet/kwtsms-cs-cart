msgctxt "Addons::name::kwtsms"
msgid "kwtSMS"
msgstr "kwtSMS"

msgctxt "Addons::description::kwtsms"
msgid "SMS notifications for your store through the kwtSMS gateway: order messages for customers and administrators, in English and Arabic."
msgstr "إشعارات الرسائل النصية لمتجرك عبر بوابة kwtSMS: رسائل الطلبات للعملاء والمسؤولين باللغتين العربية والإنجليزية."

msgctxt "SettingsSections::kwtsms::general"
msgid "General"
msgstr "عام"

msgctxt "SettingsOptions::kwtsms::info"
msgid "kwtSMS settings"
msgstr "إعدادات kwtSMS"

msgctxt "SettingsOptions::kwtsms::enabled"
msgid "Send SMS (global switch)"
msgstr "تفعيل إرسال الرسائل (المفتاح العام)"

msgctxt "SettingsOptions::kwtsms::test_mode"
msgid "Test mode"
msgstr "وضع التجربة"

msgctxt "SettingsOptions::kwtsms::pilot_mode"
msgid "Pilot mode (administrator numbers only)"
msgstr "الوضع التجريبي المحدود (أرقام المسؤولين فقط)"

msgctxt "SettingsOptions::kwtsms::default_country_code"
msgid "Default country"
msgstr "الدولة الافتراضية"

msgctxt "SettingsOptions::kwtsms::customer_sms_countries"
msgid "Countries customers can receive SMS in"
msgstr "الدول المسموح بإرسال الرسائل إلى عملائها"

msgctxt "SettingsOptions::kwtsms::placed_status_extra"
msgid "Extra order status counted as a new order"
msgstr "حالة طلب إضافية تُعد طلبا جديدا"

msgctxt "SettingsOptions::kwtsms::quiet_hours_enabled"
msgid "Quiet hours"
msgstr "ساعات الهدوء"

msgctxt "SettingsOptions::kwtsms::quiet_hours_from"
msgid "Quiet hours start"
msgstr "بداية ساعات الهدوء"

msgctxt "SettingsOptions::kwtsms::quiet_hours_to"
msgid "Quiet hours end"
msgstr "نهاية ساعات الهدوء"

msgctxt "SettingsOptions::kwtsms::max_pages_notification"
msgid "Maximum SMS pages per notification"
msgstr "الحد الأقصى لصفحات الرسالة في الإشعار الواحد"

msgctxt "SettingsOptions::kwtsms::api_username"
msgid "API username"
msgstr "اسم مستخدم API"

msgctxt "SettingsOptions::kwtsms::api_password"
msgid "API password"
msgstr "كلمة مرور API"

msgctxt "SettingsOptions::kwtsms::sender_id"
msgid "Sender ID"
msgstr "معرف المرسل"

msgctxt "SettingsOptions::kwtsms::sender_type"
msgid "Sender ID type"
msgstr "نوع معرف المرسل"

msgctxt "SettingsOptions::kwtsms::sender_id_promotional"
msgid "Promotional Sender ID"
msgstr "معرف المرسل الترويجي"

msgctxt "SettingsOptions::kwtsms::cap_recipient_hour"
msgid "Messages per recipient per hour"
msgstr "الحد الأقصى للرسائل لكل مستلم في الساعة"

msgctxt "SettingsOptions::kwtsms::cap_recipient_day"
msgid "Messages per recipient per day"
msgstr "الحد الأقصى للرسائل لكل مستلم في اليوم"

msgctxt "SettingsOptions::kwtsms::cap_admin_day"
msgid "Messages per administrator number per day"
msgstr "الحد الأقصى للرسائل لكل رقم مسؤول في اليوم"

msgctxt "SettingsOptions::kwtsms::cap_store_day"
msgid "Recipients per store per day"
msgstr "الحد الأقصى للمستلمين في المتجر يوميا"

msgctxt "SettingsOptions::kwtsms::low_balance_threshold"
msgid "Low balance threshold"
msgstr "حد تنبيه الرصيد المنخفض"

msgctxt "SettingsOptions::kwtsms::admin_phones"
msgid "Administrator phone numbers"
msgstr "أرقام هواتف المسؤولين"

msgctxt "SettingsOptions::kwtsms::admin_alert_lang"
msgid "Administrator alert language"
msgstr "لغة تنبيهات المسؤولين"

msgctxt "SettingsOptions::kwtsms::mve_customer_new_order"
msgid "Customer new order SMS (Multi-Vendor)"
msgstr "رسالة الطلب الجديد للعميل (Multi-Vendor)"

msgctxt "SettingsOptions::kwtsms::mve_admin_new_order"
msgid "Administrator new order SMS (Multi-Vendor)"
msgstr "رسالة الطلب الجديد للمسؤول (Multi-Vendor)"

msgctxt "SettingsOptions::kwtsms::mve_customer_status_scope"
msgid "Customer status SMS scope (Multi-Vendor)"
msgstr "نطاق رسائل حالة الطلب للعميل (Multi-Vendor)"

msgctxt "SettingsOptions::kwtsms::mve_vendor_triggered_sms"
msgid "SMS for changes made by vendors (Multi-Vendor)"
msgstr "رسائل التغييرات التي يجريها البائعون (Multi-Vendor)"

msgctxt "SettingsOptions::kwtsms::log_level"
msgid "Log level"
msgstr "مستوى السجل"

msgctxt "SettingsOptions::kwtsms::retention_messages_days"
msgid "Keep message logs (days)"
msgstr "مدة الاحتفاظ بسجل الرسائل (بالأيام)"

msgctxt "SettingsOptions::kwtsms::retention_attempts_days"
msgid "Keep attempt logs (days)"
msgstr "مدة الاحتفاظ بسجل المحاولات (بالأيام)"

msgctxt "SettingsOptions::kwtsms::retention_debug_days"
msgid "Keep debug logs (days)"
msgstr "مدة الاحتفاظ بسجل التصحيح (بالأيام)"

msgctxt "SettingsOptions::kwtsms::cron_url_enabled"
msgid "Cron URL mode"
msgstr "وضع تشغيل المهام المجدولة عبر الرابط"

msgctxt "SettingsOptions::kwtsms::cron_key"
msgid "Cron key"
msgstr "مفتاح المهام المجدولة"

msgctxt "SettingsOptions::kwtsms::marketplace_license_number"
msgid "Marketplace license number"
msgstr "رقم ترخيص Marketplace"

msgctxt "Languages::event.transport.kwtsms"
msgid "kwtSMS"
msgstr "kwtSMS"

msgctxt "Languages::privilege_groups.kwtsms"
msgid "kwtSMS"
msgstr "kwtSMS"

msgctxt "Languages::privileges.view_kwtsms"
msgid "View the kwtSMS dashboard and Help"
msgstr "عرض لوحة kwtSMS والمساعدة"

msgctxt "Languages::privileges.view_kwtsms_logs"
msgid "View kwtSMS logs"
msgstr "عرض سجلات kwtSMS"

msgctxt "Languages::privileges.manage_kwtsms"
msgid "Manage kwtSMS templates, admin alerts and integrations"
msgstr "إدارة قوالب kwtSMS وتنبيهات المسؤولين والتكاملات"

msgctxt "Languages::privileges.manage_kwtsms_gateway"
msgid "Manage the kwtSMS gateway: login, settings, test SMS, export and resend"
msgstr "إدارة بوابة kwtSMS: تسجيل الدخول والإعدادات والرسالة التجريبية والتصدير وإعادة الإرسال"

msgctxt "Languages::kwtsms.menu_title"
msgid "kwtSMS"
msgstr "kwtSMS"

msgctxt "Languages::kwtsms.open_settings"
msgid "Open kwtSMS settings"
msgstr "فتح إعدادات kwtSMS"

# 2026-10-20 22:35 +03: kwtsms.err.<code>, one reason per kwtSMS or LOCAL_* error code (Sms\ApiErrors::describe, PRD Appendix A), task 596
msgctxt "Languages::kwtsms.err.ERR001"
msgid "The API is turned off for this kwtSMS account. Enable it at kwtsms.com > Account > API, then try again."
msgstr "واجهة API معطلة لهذا الحساب في kwtSMS. فعّلها من kwtsms.com > الحساب > API ثم حاول مجددا."

msgctxt "Languages::kwtsms.err.ERR002"
msgid "kwtSMS reported a missing parameter. This is an add-on bug. Check the debug log and contact kwtSMS support."
msgstr "أبلغت kwtSMS عن معامل مفقود. هذا خطأ في الإضافة. راجع سجل التصحيح وتواصل مع دعم kwtSMS."

msgctxt "Languages::kwtsms.err.ERR003"
msgid "Wrong API username or password. Use the API user from kwtsms.com > Account > API, not your account mobile number or website login."
msgstr "اسم مستخدم API أو كلمة المرور غير صحيحة. استخدم مستخدم API من kwtsms.com > الحساب > API، وليس رقم جوال الحساب أو بيانات دخول الموقع."

msgctxt "Languages::kwtsms.err.ERR004"
msgid "This kwtSMS account has no API access. Contact kwtSMS support to enable it."
msgstr "لا يملك حساب kwtSMS هذا صلاحية استخدام API. تواصل مع دعم kwtSMS لتفعيلها."

msgctxt "Languages::kwtsms.err.ERR005"
msgid "This kwtSMS account is blocked. Contact kwtSMS support."
msgstr "حساب kwtSMS هذا محظور. تواصل مع دعم kwtSMS."

msgctxt "Languages::kwtsms.err.ERR006"
msgid "kwtSMS found no valid phone number in this request. Include the country code, for example 96598765432."
msgstr "لم تجد kwtSMS رقم هاتف صالحا في هذا الطلب. أضف رمز الدولة، مثل 96598765432."

msgctxt "Languages::kwtsms.err.ERR007"
msgid "The request held more than 200 numbers. This is an add-on bug. Check the debug log."
msgstr "يحتوي الطلب على أكثر من 200 رقم. هذا خطأ في الإضافة. راجع سجل التصحيح."

msgctxt "Languages::kwtsms.err.ERR008"
msgid "kwtSMS banned this Sender ID. Select another Sender ID in the settings."
msgstr "حظرت kwtSMS معرف المرسل هذا. اختر معرف مرسل آخر من الإعدادات."

msgctxt "Languages::kwtsms.err.ERR009"
msgid "The message is empty. Add text to the template."
msgstr "الرسالة فارغة. أضف نصا إلى القالب."

msgctxt "Languages::kwtsms.err.ERR010"
msgid "Your kwtSMS balance is zero. Recharge credits at kwtsms.com."
msgstr "رصيد kwtSMS لديك صفر. اشحن الرصيد من kwtsms.com."

msgctxt "Languages::kwtsms.err.ERR011"
msgid "Your kwtSMS balance is too low for this send. Buy more credits at kwtsms.com."
msgstr "رصيد kwtSMS لا يكفي لهذه الرسالة. اشترِ رصيدا إضافيا من kwtsms.com."

msgctxt "Languages::kwtsms.err.ERR012"
msgid "The message is longer than 7 SMS pages. Shorten the text so it fits in 7 pages or fewer. Messages of more than 7 pages are rejected."
msgstr "الرسالة أطول من 7 صفحات رسائل نصية. اختصر النص ليتسع في 7 صفحات أو أقل. تُرفض الرسائل التي تزيد على 7 صفحات."

msgctxt "Languages::kwtsms.err.ERR013"
msgid "The kwtSMS send queue is full (1000 messages). Try again in a few minutes."
msgstr "قائمة انتظار الإرسال في kwtSMS ممتلئة (1000 رسالة). حاول بعد دقائق."

msgctxt "Languages::kwtsms.err.ERR024"
msgid "This server's IP address isn't on the kwtSMS API allow list. Add it at kwtsms.com > Account > API > IP Lockdown, or turn the lockdown off."
msgstr "عنوان IP لهذا الخادم غير مدرج في القائمة المسموح بها في kwtSMS. أضفه من kwtsms.com > الحساب > API > تقييد IP، أو أوقف التقييد."

msgctxt "Languages::kwtsms.err.ERR025"
msgid "A phone number isn't valid. Use digits only, with the country code, for example 96598765432."
msgstr "رقم هاتف غير صالح. استخدم الأرقام فقط مع رمز الدولة، مثل 96598765432."

msgctxt "Languages::kwtsms.err.ERR026"
msgid "kwtSMS has no route to this country. Ask kwtSMS support to activate it for your account."
msgstr "لا يوجد مسار في kwtSMS لهذه الدولة. اطلب من دعم kwtSMS تفعيلها لحسابك."

msgctxt "Languages::kwtsms.err.ERR027"
msgid "The message contains HTML. Remove the tags from the template."
msgstr "تحتوي الرسالة على وسوم HTML. أزل الوسوم من القالب."

msgctxt "Languages::kwtsms.err.ERR031"
msgid "kwtSMS rejected the message for bad language. Change the wording."
msgstr "رفضت kwtSMS الرسالة بسبب ألفاظ غير لائقة. غيّر الصياغة."

msgctxt "Languages::kwtsms.err.ERR032"
msgid "kwtSMS rejected the message as spam. Change the wording."
msgstr "رفضت kwtSMS الرسالة لاشتباهها بأنها غير مرغوبة. غيّر الصياغة."

msgctxt "Languages::kwtsms.err.ERR033"
msgid "kwtSMS has no active coverage for this account. Contact kwtSMS support."
msgstr "لا توجد تغطية فعالة لهذا الحساب في kwtSMS. تواصل مع دعم kwtSMS."

msgctxt "Languages::kwtsms.err.ERR034"
msgid "kwtSMS blocked this request because the server's IP address looks like a proxy or VPN. Contact kwtSMS support."
msgstr "حظرت kwtSMS هذا الطلب لأن عنوان IP للخادم يبدو كوكيل أو شبكة VPN. تواصل مع دعم kwtSMS."

msgctxt "Languages::kwtsms.err.ERR035"
msgid "The daily limit for international SMS is reached. Messages to international numbers fail until the limit resets."
msgstr "بلغ الحساب الحد اليومي للرسائل الدولية. ستفشل الرسائل إلى الأرقام الدولية حتى تتم إعادة ضبط الحد."

msgctxt "Languages::kwtsms.err.ERR036"
msgid "kwtSMS rejected the message because it contains an emoji or an unsupported symbol. Remove it from the template."
msgstr "رفضت kwtSMS الرسالة لأنها تحتوي رمزا تعبيريا أو رمزا غير مدعوم. أزله من القالب."

msgctxt "Languages::kwtsms.err.LOCAL_TIMEOUT"
msgid "kwtSMS didn't answer in time. The request may have been received. Check the kwtSMS archive and queue before you resend."
msgstr "لم تردّ kwtSMS في الوقت المحدد. قد يكون الطلب وصل. راجع أرشيف kwtSMS وقائمة الانتظار قبل إعادة الإرسال."

msgctxt "Languages::kwtsms.err.LOCAL_CONNECT"
msgid "Could not reach kwtSMS. Nothing was sent. Check that this server can open https://www.kwtsms.com."
msgstr "تعذر الوصول إلى kwtSMS. لم يُرسل شيء. تحقق من أن هذا الخادم يستطيع فتح https://www.kwtsms.com."

msgctxt "Languages::kwtsms.err.LOCAL_TLS"
msgid "The secure connection to kwtSMS failed (certificate or TLS error). Nothing was sent. Check the CA certificates and the clock of this server."
msgstr "فشل الاتصال الآمن مع kwtSMS (خطأ في الشهادة أو TLS). لم يُرسل شيء. تحقق من شهادات CA وساعة هذا الخادم."

msgctxt "Languages::kwtsms.err.LOCAL_DNS"
msgid "Could not find the kwtSMS server (DNS lookup failed). Nothing was sent. Check the DNS settings of this server."
msgstr "تعذر العثور على خادم kwtSMS (فشل بحث DNS). لم يُرسل شيء. تحقق من إعدادات DNS لهذا الخادم."

msgctxt "Languages::kwtsms.err.LOCAL_BAD_JSON"
msgid "kwtSMS sent a reply this add-on can't read. Check the kwtSMS archive and queue before you resend."
msgstr "أرسلت kwtSMS ردا لا تستطيع الإضافة قراءته. راجع أرشيف kwtSMS وقائمة الانتظار قبل إعادة الإرسال."

msgctxt "Languages::kwtsms.err.LOCAL_HTTP"
msgid "kwtSMS answered with an unexpected HTTP status and no usable reply. Check the kwtSMS archive and queue before you resend."
msgstr "ردّت kwtSMS برمز HTTP غير متوقع ودون رد مفهوم. راجع أرشيف kwtSMS وقائمة الانتظار قبل إعادة الإرسال."

msgctxt "Languages::kwtsms.err.LOCAL_CANCELLED"
msgid "The request was cancelled before it was sent."
msgstr "أُلغي الطلب قبل إرساله."

msgctxt "Languages::kwtsms.err.LOCAL_HTML"
msgid "The message still contains HTML-like text. Remove the angle brackets from the template."
msgstr "ما زالت الرسالة تحتوي نصا يشبه HTML. أزل الأقواس الزاوية من القالب."

msgctxt "Languages::kwtsms.err.LOCAL_BAD_INPUT"
msgid "The request was invalid and was not sent. This is an add-on bug. Check the debug log."
msgstr "الطلب غير صالح ولم يُرسل. هذا خطأ في الإضافة. راجع سجل التصحيح."

msgctxt "Languages::kwtsms.err.LOCAL_BREAKER"
msgid "kwtSMS has been unreachable. Sending is paused for 5 minutes. Messages are kept and sent later."
msgstr "تعذر الوصول إلى kwtSMS. الإرسال متوقف 5 دقائق. تُحفظ الرسائل وتُرسل لاحقا."

msgctxt "Languages::kwtsms.err.LOCAL_DEFERRED"
msgid "An earlier call in this request could not reach kwtSMS. This message is kept and sent later."
msgstr "تعذر الوصول إلى kwtSMS في استدعاء سابق ضمن هذا الطلب. تُحفظ هذه الرسالة وتُرسل لاحقا."

msgctxt "Languages::kwtsms.err.LOCAL_BUSY"
msgid "The API rate limiter was busy. The message is kept and sent later."
msgstr "منظم معدل الطلبات مشغول. تُحفظ الرسالة وتُرسل لاحقا."

msgctxt "Languages::kwtsms.err.LOCAL_NO_GUARD"
msgid "The request guard is missing, so nothing was sent. This is an add-on bug."
msgstr "حارس الطلبات غير موجود فلم يُرسل شيء. هذا خطأ في الإضافة."

msgctxt "Languages::kwtsms.err.LOCAL_REFUSED"
msgid "The add-on refused to contact a host other than kwtSMS. Nothing was sent."
msgstr "رفضت الإضافة الاتصال بمضيف غير kwtSMS. لم يُرسل شيء."

msgctxt "Languages::kwtsms.err.LOCAL_SKIPPED"
msgid "Not sent because an earlier part of the same send failed."
msgstr "لم تُرسل لأن جزءا سابقا من الإرسال نفسه فشل."

msgctxt "Languages::kwtsms.err.LOCAL_ERROR"
msgid "An unexpected error stopped the request. Check the debug log."
msgstr "أوقف خطأ غير متوقع الطلب. راجع سجل التصحيح."

msgctxt "Languages::kwtsms.err.unknown"
msgid "kwtSMS returned the error [code]. Check the debug log for details."
msgstr "أعادت kwtSMS الخطأ [code]. راجع سجل التصحيح لمعرفة التفاصيل."

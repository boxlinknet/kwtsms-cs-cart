msgctxt "Languages::kwtsms.templates.editor_title"
msgid "[row] in [language]"
msgstr "[row] باللغة [language]"

msgctxt "Languages::kwtsms.templates.editor_label"
msgid "Text in [language]"
msgstr "النص باللغة [language]"

msgctxt "Languages::kwtsms.templates.editor_help_generic"
msgid "This row has no text of its own. The box starts from the text that is sent now. Saving makes it this row's own text."
msgstr "لا نص خاص بهذا الصف. يبدأ الحقل بالنص المُرسَل الآن، وعند الحفظ يصبح نصًا خاصًا بهذا الصف."

msgctxt "Languages::kwtsms.templates.editor_help_default_lang"
msgid "This row has no text in this language. The box starts from the [language] text that is sent now."
msgstr "لا نص لهذا الصف بهذه اللغة. يبدأ الحقل بنص [language] المُرسَل الآن."

msgctxt "Languages::kwtsms.templates.editor_help_none"
msgid "No text yet. Without a text, this SMS is skipped."
msgstr "لا نص بعد. بدون نص تُتخطى هذه الرسالة."

msgctxt "Languages::kwtsms.templates.counter_title"
msgid "Length with sample data"
msgstr "الطول ببيانات تجريبية"

msgctxt "Languages::kwtsms.templates.counter_chars"
msgid "Characters"
msgstr "الأحرف"

msgctxt "Languages::kwtsms.templates.counter_sms"
msgid "SMS"
msgstr "الرسائل"

msgctxt "Languages::kwtsms.templates.counter_encoding"
msgid "Encoding"
msgstr "الترميز"

msgctxt "Languages::kwtsms.templates.worst_title"
msgid "Worst case"
msgstr "أسوأ حالة"

msgctxt "Languages::kwtsms.templates.worst_help"
msgid "Longest values: a 20-character store name, a 10-character Arabic first name, a 6-digit order ID and an 8-digit total."
msgstr "أطول القيم: اسم متجر من 20 حرفًا، واسم أول عربي من 10 أحرف، ورقم طلب من 6 أرقام، وإجمالي من 8 أرقام."

msgctxt "Languages::kwtsms.templates.worst_unicode_note"
msgid "May switch to Unicode when a placeholder contains Arabic: 70 characters per SMS instead of 160."
msgstr "قد يتحول إلى يونيكود عندما يحتوي أحد العناصر المتغيرة على حروف عربية: 70 حرفًا لكل رسالة بدل 160."

msgctxt "Languages::kwtsms.templates.counter_over"
msgid "More than [max] SMS. kwtSMS rejects it."
msgstr "أكثر من [max] رسائل. ترفضها kwtSMS."

msgctxt "Languages::kwtsms.templates.chips_title"
msgid "Placeholders"
msgstr "العناصر المتغيرة"

msgctxt "Languages::kwtsms.templates.chips_help"
msgid "Select one to insert it at the cursor."
msgstr "اختر عنصرًا لإدراجه عند المؤشر."

msgctxt "Languages::kwtsms.templates.ph_store_name"
msgid "Your SMS brand name"
msgstr "اسم علامتك التجارية في الرسائل"

msgctxt "Languages::kwtsms.templates.ph_order_id"
msgid "Order number"
msgstr "رقم الطلب"

msgctxt "Languages::kwtsms.templates.ph_order_ids"
msgid "Order numbers of a checkout: the first three, then +N"
msgstr "أرقام طلبات عملية الدفع: أول ثلاثة ثم +N"

msgctxt "Languages::kwtsms.templates.ph_vendor_name"
msgid "Vendor name"
msgstr "اسم البائع"

msgctxt "Languages::kwtsms.templates.ph_order_total"
msgid "Order total in the order's currency"
msgstr "إجمالي الطلب بعملة الطلب"

msgctxt "Languages::kwtsms.templates.ph_currency"
msgid "Currency code, or its Arabic name in Arabic texts"
msgstr "رمز العملة، أو اسمها بالعربية في النصوص العربية"

msgctxt "Languages::kwtsms.templates.ph_order_status"
msgid "Order status name"
msgstr "اسم حالة الطلب"

msgctxt "Languages::kwtsms.templates.ph_customer_first_name"
msgid "Customer's first name"
msgstr "الاسم الأول للعميل"

msgctxt "Languages::kwtsms.templates.ph_customer_last_name"
msgid "Customer's last name"
msgstr "اسم عائلة العميل"

msgctxt "Languages::kwtsms.templates.ph_order_date"
msgid "Order date"
msgstr "تاريخ الطلب"

msgctxt "Languages::kwtsms.templates.ph_payment_method"
msgid "Payment method"
msgstr "طريقة الدفع"

msgctxt "Languages::kwtsms.templates.ph_shipping_method"
msgid "Shipping method"
msgstr "طريقة الشحن"

msgctxt "Languages::kwtsms.templates.warn_store_name_missing"
msgid "Customer texts need {store_name}, so customers know who sent the SMS. This text can't be saved without it."
msgstr "نصوص العملاء تحتاج {store_name} ليعرف العميل من أرسل الرسالة. لا يمكن حفظ هذا النص بدونه."

msgctxt "Languages::kwtsms.templates.warn_html_span"
msgid "kwtSMS rejects text with angle brackets around other text: [found]. Remove the brackets."
msgstr "ترفض kwtSMS النص الذي يحيط فيه قوسا الزاوية بنص آخر: [found]. أزل القوسين."

msgctxt "Languages::kwtsms.templates.warn_adjacent"
msgid "Two placeholders touch: [found]. Their values can run together. Put a space or a word between them."
msgstr "عنصران متغيران متلاصقان: [found]. قد تلتصق قيمتاهما. ضع مسافة أو كلمة بينهما."

msgctxt "Languages::kwtsms.templates.warn_entity_fragment"
msgid "A symbol next to a placeholder can turn into another character: [found]. Put a space between them."
msgstr "رمز بجانب عنصر متغير قد يتحول إلى حرف آخر: [found]. ضع مسافة بينهما."

msgctxt "Languages::kwtsms.templates.warn_promotional"
msgid "Promotional wording: [found]. Keep order texts about the order. Promotions don't reach numbers on the do-not-disturb (DND) list."
msgstr "عبارات ترويجية: [found]. أبقِ نصوص الطلبات عن الطلب. الرسائل الترويجية لا تصل إلى الأرقام المسجلة في قائمة عدم الإزعاج (DND)."

msgctxt "Languages::kwtsms.templates.warn_unknown"
msgid "Unknown placeholders: [found]. An SMS that holds one isn't sent."
msgstr "عناصر متغيرة غير معروفة: [found]. الرسالة التي تحتوي واحدًا منها لا تُرسل."

msgctxt "Languages::kwtsms.templates.preview_title"
msgid "Preview"
msgstr "المعاينة"

msgctxt "Languages::kwtsms.templates.preview_sample"
msgid "Sample data"
msgstr "بيانات تجريبية"

msgctxt "Languages::kwtsms.templates.preview_order"
msgid "Order number"
msgstr "رقم طلب"

msgctxt "Languages::kwtsms.templates.preview_order_label"
msgid "Order number"
msgstr "رقم الطلب"

msgctxt "Languages::kwtsms.templates.preview_button"
msgid "Show preview"
msgstr "عرض المعاينة"

msgctxt "Languages::kwtsms.templates.preview_note"
msgid "A preview sends nothing."
msgstr "المعاينة لا ترسل شيئًا."

msgctxt "Languages::kwtsms.templates.preview_result"
msgid "Text as it would be sent"
msgstr "النص كما سيُرسَل"

msgctxt "Languages::kwtsms.templates.preview_failed"
msgid "The preview didn't load. Reload the page and try again."
msgstr "تعذّر تحميل المعاينة. أعد تحميل الصفحة وحاول مرة أخرى."

msgctxt "Languages::kwtsms.templates.preview_empty"
msgid "Nothing would be sent: the text is empty after cleaning."
msgstr "لن يُرسل شيء: النص فارغ بعد التنظيف."

msgctxt "Languages::kwtsms.templates.preview_leftover"
msgid "A placeholder is left in the text, so this SMS wouldn't be sent."
msgstr "بقي عنصر متغير في النص، لذلك لن تُرسل هذه الرسالة."

msgctxt "Languages::kwtsms.templates.preview_removed"
msgid "Cleaning removed: [found]"
msgstr "أزال التنظيف: [found]"

msgctxt "Languages::kwtsms.templates.preview_no_orders"
msgid "You need permission to view orders to preview with an order number."
msgstr "يلزمك إذن عرض الطلبات للمعاينة برقم طلب."

msgctxt "Languages::kwtsms.templates.preview_no_order"
msgid "Order [id] not found."
msgstr "الطلب [id] غير موجود."

msgctxt "Languages::kwtsms.templates.save"
msgid "Save text"
msgstr "حفظ النص"

msgctxt "Languages::kwtsms.templates.save_anyway"
msgid "Save anyway"
msgstr "الحفظ على أي حال"

msgctxt "Languages::kwtsms.templates.reset"
msgid "Reset to default text"
msgstr "إعادة النص الافتراضي"

msgctxt "Languages::kwtsms.templates.reset_confirm"
msgid "Replace this text with the default text?"
msgstr "استبدال هذا النص بالنص الافتراضي؟"

msgctxt "Languages::kwtsms.templates.saved"
msgid "Text saved: [row], [language]."
msgstr "تم حفظ النص: [row]، [language]."

msgctxt "Languages::kwtsms.templates.saved_empty"
msgid "The text is empty now, so this row falls back to the next available text."
msgstr "النص فارغ الآن، لذلك يعود هذا الصف إلى أول نص متاح بعده."

msgctxt "Languages::kwtsms.templates.removed"
msgid "Cleaning removed these characters before saving: [found]"
msgstr "أزال التنظيف هذه الأحرف قبل الحفظ: [found]"

msgctxt "Languages::kwtsms.templates.not_saved_store_name"
msgid "Not saved. Customer texts must include {store_name}, so customers know who sent the SMS."
msgstr "لم يُحفظ النص. يجب أن تتضمن نصوص العملاء {store_name} ليعرف العميل من أرسل الرسالة."

msgctxt "Languages::kwtsms.templates.not_saved_unknown"
msgid "Not saved. Unknown placeholders: [found]. An SMS that holds one isn't sent. Fix the name, or select Save anyway."
msgstr "لم يُحفظ النص. عناصر متغيرة غير معروفة: [found]. الرسالة التي تحتوي واحدًا منها لا تُرسل. صحّح الاسم أو اختر الحفظ على أي حال."

msgctxt "Languages::kwtsms.templates.not_saved_too_long"
msgid "Not saved. The text is longer than [max] characters."
msgstr "لم يُحفظ النص. طوله يتجاوز [max] حرفًا."

msgctxt "Languages::kwtsms.templates.not_saved_unknown_row"
msgid "Nothing changed. That row or language doesn't exist."
msgstr "لم يتغير شيء. هذا الصف أو هذه اللغة غير موجودة."

msgctxt "Languages::kwtsms.templates.reset_done"
msgid "Default text restored: [row], [language]."
msgstr "تمت استعادة النص الافتراضي: [row]، [language]."

msgctxt "Languages::kwtsms.templates.reset_cleared"
msgid "No default text ships for [row] in [language]. The text is cleared, so this row falls back to the next available text."
msgstr "لا يتوفر نص افتراضي لـ [row] باللغة [language]. تم مسح النص، لذلك يعود هذا الصف إلى أول نص متاح بعده."

msgctxt "Languages::kwtsms.templates.loaded"
msgid "Default texts loaded for [language]: [count]."
msgstr "تم تحميل النصوص الافتراضية للغة [language]: [count]."

msgctxt "Languages::kwtsms.templates.loaded_none"
msgid "Nothing to load. Every [language] text is already set or edited."
msgstr "لا شيء لتحميله. كل نصوص [language] موجودة أو معدّلة."

msgctxt "Languages::kwtsms.templates.switch_on"
msgid "SMS turned on: [row]."
msgstr "تم تشغيل الرسائل: [row]."

msgctxt "Languages::kwtsms.templates.switch_off"
msgid "SMS turned off: [row]."
msgstr "تم إيقاف الرسائل: [row]."

msgctxt "Languages::kwtsms.templates.switch_denied"
msgid "Nothing changed. You need permission to manage notification settings."
msgstr "لم يتغير شيء. يلزمك إذن إدارة إعدادات الإشعارات."

msgctxt "Languages::kwtsms.templates.switch_unknown"
msgid "Nothing changed. That row has no SMS switch."
msgstr "لم يتغير شيء. ليس لهذا الصف مفتاح رسائل."

# 2026-10-21 05:20 +03: Task 1.12 fix round 1, task 596. The badge of the Multi-Vendor checkout row, "Send a test of this template" and the SMS
# brand-name editor of the Templates page.
msgctxt "Languages::kwtsms.templates.badge_placed"
msgid "Uses the Order placed text"
msgstr "يستخدم نص «طلب جديد»"

msgctxt "Languages::kwtsms.templates.editor_help_placed"
msgid "This row has no text of its own. The box starts from the Order placed text that is sent now. Saving makes it this row's own text."
msgstr "لا نص خاص بهذا الصف. يبدأ الحقل بنص «طلب جديد» المُرسَل الآن، وعند الحفظ يصبح نصًا خاصًا بهذا الصف."

msgctxt "Languages::kwtsms.templates.test_title"
msgid "Send a test of this template"
msgstr "إرسال تجربة لهذا القالب"

msgctxt "Languages::kwtsms.templates.test_help"
msgid "Sends the text above, filled with the sample data, to one number. In test mode kwtSMS accepts the message but does not deliver it. It counts toward the limit of [max] test SMS an hour."
msgstr "يرسل النص أعلاه مملوءًا بالبيانات التجريبية إلى رقم واحد. في وضع الاختبار تقبل kwtSMS الرسالة ولا تسلّمها. تُحتسب ضمن حد [max] رسائل تجريبية في الساعة."

msgctxt "Languages::kwtsms.templates.test_send"
msgid "Send test"
msgstr "إرسال التجربة"

msgctxt "Languages::kwtsms.templates.test_locked"
msgid "Sending a test needs permission to manage the gateway."
msgstr "إرسال تجربة يتطلب إذن إدارة بوابة الرسائل."

msgctxt "Languages::kwtsms.templates.test_empty"
msgid "Nothing to send. The text is empty once it is cleaned."
msgstr "لا شيء للإرسال. النص فارغ بعد التنظيف."

msgctxt "Languages::kwtsms.templates.test_unavailable"
msgid "Sending a test is not available right now."
msgstr "إرسال التجربة غير متاح الآن."

msgctxt "Languages::kwtsms.templates.brand_title"
msgid "SMS brand name"
msgstr "اسم العلامة في الرسائل"

msgctxt "Languages::kwtsms.templates.brand_help"
msgid "Shown instead of {store_name} at the start of customer SMS in [language]. Up to [max] characters. Leave a field empty to use the storefront name, then the company name."
msgstr "يظهر بدل {store_name} في بداية رسائل العملاء باللغة [language]. حتى [max] حرفًا. اترك الحقل فارغًا لاستخدام اسم واجهة المتجر ثم اسم الشركة."

msgctxt "Languages::kwtsms.templates.brand_save"
msgid "Save brand name"
msgstr "حفظ اسم العلامة"

msgctxt "Languages::kwtsms.templates.brand_none"
msgid "No storefront found."
msgstr "لا توجد واجهة متجر."

msgctxt "Languages::kwtsms.templates.brand_unicode_warn"
msgid "This name has characters that are not plain text. Every English SMS that carries it is sent as Unicode: 70 characters per SMS instead of 160."
msgstr "في هذا الاسم أحرف ليست نصًا عاديًا. كل رسالة إنجليزية تحمله تُرسل بترميز يونيكود: 70 حرفًا للرسالة بدل 160."

msgctxt "Languages::kwtsms.templates.brand_saved"
msgid "SMS brand name saved: [language]."
msgstr "تم حفظ اسم العلامة: [language]."

msgctxt "Languages::kwtsms.templates.brand_unchanged"
msgid "No brand name changed."
msgstr "لم يتغير أي اسم علامة."

msgctxt "Languages::kwtsms.templates.brand_cut"
msgid "A name was cut to [max] characters."
msgstr "تم اقتطاع اسم إلى [max] حرفًا."

msgctxt "Languages::kwtsms.templates.brand_unicode"
msgid "The English brand name has characters that are not plain text, so English SMS that carry it are sent as Unicode (70 characters per SMS)."
msgstr "في اسم العلامة الإنجليزي أحرف ليست نصًا عاديًا، لذلك تُرسل الرسائل الإنجليزية التي تحمله بترميز يونيكود (70 حرفًا للرسالة)."

msgctxt "Languages::kwtsms.templates.brand_unknown_storefront"
msgid "A storefront that is not in this store was ignored."
msgstr "تم تجاهل واجهة متجر ليست ضمن هذا المتجر."


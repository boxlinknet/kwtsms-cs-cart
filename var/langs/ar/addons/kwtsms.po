msgstr "إضافات لها أحداث SMS خاصة بها. يبدأ كل مفتاح مطفأ. فعّل ما تريد من صفحة القوالب."

msgctxt "Languages::kwtsms.integrations.later.rma"
msgid "Returns (RMA)"
msgstr "المرتجعات (RMA)"

msgctxt "Languages::kwtsms.integrations.later.call_requests"
msgid "Call requests"
msgstr "طلبات الاتصال"

msgctxt "Languages::kwtsms.integrations.later.gift_certificates"
msgid "Gift certificates"
msgstr "شهادات الهدايا"

msgctxt "Languages::kwtsms.integrations.later.discussion"
msgid "Comments and discussion"
msgstr "التعليقات والنقاش"

msgctxt "Languages::kwtsms.integrations.later.vendor_communication"

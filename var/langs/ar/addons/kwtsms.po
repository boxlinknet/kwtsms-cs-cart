msgctxt "Languages::kwtsms.settings.fail_spike_title"
msgid "Send failure alert"
msgstr "تنبيه فشل الإرسال"

msgctxt "Languages::kwtsms.settings.field.fail_spike_alert"
msgid "Failure alert"
msgstr "تنبيه الفشل"

msgctxt "Languages::kwtsms.settings.fail_spike_label"

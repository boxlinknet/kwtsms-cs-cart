msgctxt "Languages::kwtsms.templates.not_saved_too_long"
msgid "Not saved. The text is longer than [max] characters."
msgstr "لم يُحفظ النص. طوله يتجاوز [max] حرفًا."

msgctxt "Languages::kwtsms.templates.not_saved_unknown_row"
msgid "Nothing changed. That row or language doesn't exist."
msgstr "لم يتغير شيء. هذا الصف أو هذه اللغة غير موجودة."

msgctxt "Languages::kwtsms.templates.reset_done"
msgid "Default text restored: [row], [language]."
msgstr "تمت استعادة النص الافتراضي: [row]، [language]."

msgctxt "Languages::kwtsms.templates.reset_cleared"
msgid "No default text ships for [row] in [language]. The text is cleared, so this row falls back to the next available text."
msgstr "لا يتوفر نص افتراضي لـ [row] باللغة [language]. تم مسح النص، لذلك يعود هذا الصف إلى أول نص متاح بعده."

msgctxt "Languages::kwtsms.templates.loaded"
msgid "Default texts loaded for [language]: [count]."
msgstr "تم تحميل النصوص الافتراضية للغة [language]: [count]."

msgctxt "Languages::kwtsms.templates.loaded_none"
msgid "Nothing to load. Every [language] text is already set or edited."
msgstr "لا شيء لتحميله. كل نصوص [language] موجودة أو معدّلة."

msgctxt "Languages::kwtsms.templates.switch_on"
msgid "SMS turned on: [row]."
msgstr "تم تشغيل الرسائل: [row]."

msgctxt "Languages::kwtsms.templates.switch_off"
msgid "SMS turned off: [row]."
msgstr "تم إيقاف الرسائل: [row]."

msgctxt "Languages::kwtsms.templates.switch_denied"
msgid "Nothing changed. You need permission to manage notification settings."
msgstr "لم يتغير شيء. يلزمك إذن إدارة إعدادات الإشعارات."

msgctxt "Languages::kwtsms.templates.switch_unknown"
msgid "Nothing changed. That row has no SMS switch."
msgstr "لم يتغير شيء. ليس لهذا الصف مفتاح رسائل."


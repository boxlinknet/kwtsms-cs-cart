msgctxt "Languages::kwtsms.templates.switch_generic_vendor"
msgid "No switch here. Turn vendor SMS on in Administration > Notifications."
msgstr "لا مفتاح هنا. فعّل رسائل البائع من الإدارة > الإشعارات."

msgctxt "Languages::kwtsms.logs.reason.conditions_unreadable"
msgid "The Conditions of this row could not be read, so no SMS was sent. Save the Conditions again."
msgstr "تعذرت قراءة شروط هذا الصف فلم تُرسل الرسالة. احفظ الشروط من جديد."

msgstr "واجهات المتجر"

msgctxt "Languages::kwtsms.help.vendors.title"
msgid "Vendor SMS"
msgstr "رسائل البائعين"

msgctxt "Languages::kwtsms.help.optout.title"
msgid "Customer opt-out"
msgstr "إيقاف العميل للرسائل"


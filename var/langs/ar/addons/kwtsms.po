msgctxt "Languages::kwtsms.templates.badge_placed"
msgid "Uses the Order placed text"
msgstr "يستخدم نص «طلب جديد»"

msgctxt "Languages::kwtsms.templates.editor_help_placed"
msgid "This row has no text of its own. The box starts from the Order placed text that is sent now. Saving makes it this row's own text."
msgstr "لا نص خاص بهذا الصف. يبدأ الحقل بنص «طلب جديد» المُرسَل الآن، وعند الحفظ يصبح نصًا خاصًا بهذا الصف."

msgctxt "Languages::kwtsms.templates.test_title"
msgid "Send a test of this template"
msgstr "إرسال تجربة لهذا القالب"

msgctxt "Languages::kwtsms.templates.test_help"
msgid "Sends the text above, filled with the sample data, to one number. In test mode kwtSMS accepts the message but does not deliver it. It counts toward the limit of [max] test SMS an hour."
msgstr "يرسل النص أعلاه مملوءًا بالبيانات التجريبية إلى رقم واحد. في وضع الاختبار تقبل kwtSMS الرسالة ولا تسلّمها. تُحتسب ضمن حد [max] رسائل تجريبية في الساعة."

msgctxt "Languages::kwtsms.templates.test_send"
msgid "Send test"
msgstr "إرسال التجربة"

msgctxt "Languages::kwtsms.templates.test_locked"
msgid "Sending a test needs permission to manage the gateway."
msgstr "إرسال تجربة يتطلب إذن إدارة بوابة الرسائل."

msgctxt "Languages::kwtsms.templates.test_empty"
msgid "Nothing to send. The text is empty once it is cleaned."
msgstr "لا شيء للإرسال. النص فارغ بعد التنظيف."

msgctxt "Languages::kwtsms.templates.test_unavailable"
msgid "Sending a test is not available right now."
msgstr "إرسال التجربة غير متاح الآن."

msgctxt "Languages::kwtsms.templates.brand_title"
msgid "SMS brand name"
msgstr "اسم العلامة في الرسائل"

msgctxt "Languages::kwtsms.templates.brand_help"
msgid "Shown instead of {store_name} at the start of customer SMS in [language]. Up to [max] characters. Leave a field empty to use the storefront name, then the company name."
msgstr "يظهر بدل {store_name} في بداية رسائل العملاء باللغة [language]. حتى [max] حرفًا. اترك الحقل فارغًا لاستخدام اسم واجهة المتجر ثم اسم الشركة."

msgctxt "Languages::kwtsms.templates.brand_save"
msgid "Save brand name"
msgstr "حفظ اسم العلامة"

msgctxt "Languages::kwtsms.templates.brand_none"
msgid "No storefront found."
msgstr "لا توجد واجهة متجر."

# 2026-10-21 14:06 +03: the fallback of an empty brand name, shown as text under the field (cleanup 2 item 3), task 596.
msgctxt "Languages::kwtsms.templates.brand_fallback"
msgid "If left empty, SMS use:"
msgstr "عند ترك الحقل فارغًا تستخدم الرسائل:"

# 2026-10-21 14:06 +03: the fallback when neither the storefront nor the company has a name (cleanup 2 item 3), task 596.
msgctxt "Languages::kwtsms.templates.brand_fallback_none"
msgid "If left empty, no name is added: this storefront and its company have no name."
msgstr "عند ترك الحقل فارغًا لا يُضاف اسم: ليس لواجهة المتجر ولا للشركة اسم."

msgctxt "Languages::kwtsms.templates.brand_unicode_warn"
msgid "This name has characters that are not plain text. Every English SMS that carries it is sent as Unicode: 70 characters per SMS instead of 160."
msgstr "في هذا الاسم أحرف ليست نصًا عاديًا. كل رسالة إنجليزية تحمله تُرسل بترميز يونيكود: 70 حرفًا للرسالة بدل 160."

msgctxt "Languages::kwtsms.templates.brand_saved"
msgid "SMS brand name saved: [language]."
msgstr "تم حفظ اسم العلامة: [language]."

msgctxt "Languages::kwtsms.templates.brand_unchanged"
msgid "No brand name changed."
msgstr "لم يتغير أي اسم علامة."

msgctxt "Languages::kwtsms.templates.brand_cut"
msgid "A name was cut to [max] characters."
msgstr "تم اقتطاع اسم إلى [max] حرفًا."

msgctxt "Languages::kwtsms.templates.brand_unicode"
msgid "The English brand name has characters that are not plain text, so English SMS that carry it are sent as Unicode (70 characters per SMS)."
msgstr "في اسم العلامة الإنجليزي أحرف ليست نصًا عاديًا، لذلك تُرسل الرسائل الإنجليزية التي تحمله بترميز يونيكود (70 حرفًا للرسالة)."

msgctxt "Languages::kwtsms.templates.brand_unknown_storefront"
msgid "A storefront that is not in this store was ignored."
msgstr "تم تجاهل واجهة متجر ليست ضمن هذا المتجر."


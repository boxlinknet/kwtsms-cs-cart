msgstr "No switch here. Turn vendor SMS on in Administration > Notifications."

msgctxt "Languages::kwtsms.logs.reason.conditions_unreadable"
msgid "The Conditions of this row could not be read, so no SMS was sent. Save the Conditions again."
msgstr "The Conditions of this row could not be read, so no SMS was sent. Save the Conditions again."

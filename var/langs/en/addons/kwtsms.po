msgid "These settings exist only in Multi-Vendor. Nothing was changed."
msgstr "These settings exist only in Multi-Vendor. Nothing was changed."

msgctxt "Languages::kwtsms.integrations.captcha.title"
msgid "CAPTCHA at checkout"
msgstr "CAPTCHA at checkout"

msgctxt "Languages::kwtsms.integrations.captcha.on"
msgid "CAPTCHA is on for checkout. Fake guest orders are less likely to cost you SMS credits."
msgstr "CAPTCHA is on for checkout. Fake guest orders are less likely to cost you SMS credits."

msgctxt "Languages::kwtsms.integrations.captcha.off"
msgid "CAPTCHA is off for checkout. Bots can place fake guest orders, and every order sends SMS. Turn on the Checkout scenario in the CAPTCHA settings."
msgstr "CAPTCHA is off for checkout. Bots can place fake guest orders, and every order sends SMS. Turn on the Checkout scenario in the CAPTCHA settings."

msgctxt "Languages::kwtsms.integrations.captcha.recaptcha_on"
msgid "The reCAPTCHA add-on is active."
msgstr "The reCAPTCHA add-on is active."

msgctxt "Languages::kwtsms.integrations.captcha.recaptcha_off"
msgid "The reCAPTCHA add-on is not active."
msgstr "The reCAPTCHA add-on is not active."

msgctxt "Languages::kwtsms.integrations.clickatell.title"
msgid "Core SMS notifications (Clickatell)"
msgstr "Core SMS notifications (Clickatell)"

msgctxt "Languages::kwtsms.integrations.clickatell.active"
msgid "The core SMS notifications add-on is active. It sends its own SMS through Clickatell, so a customer or admin can get two messages for one event. Turn it off if kwtSMS should be the only sender."
msgstr "The core SMS notifications add-on is active. It sends its own SMS through Clickatell, so a customer or admin can get two messages for one event. Turn it off if kwtSMS should be the only sender."

msgctxt "Languages::kwtsms.integrations.clickatell.inactive"
msgid "Not active. kwtSMS is the only SMS sender."
msgstr "Not active. kwtSMS is the only SMS sender."


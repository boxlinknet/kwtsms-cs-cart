# kwtsms.alert.<condition>.title / .text are the admin notices and e-mails of Alerts\AdminAlerts (PRD 6.13).
msgctxt "Languages::kwtsms.outcome.accepted"
msgid "Accepted by kwtSMS for delivery."
msgstr "Accepted by kwtSMS for delivery."

msgctxt "Languages::kwtsms.outcome.test_queued"
msgid "Accepted in test mode, not delivered. Delete it from your kwtSMS queue to get the credits back."
msgstr "Accepted in test mode, not delivered. Delete it from your kwtSMS queue to get the credits back."

msgctxt "Languages::kwtsms.outcome.partial_accept"
msgid "kwtSMS accepted fewer numbers than were sent. Check the message log of this send."
msgstr "kwtSMS accepted fewer numbers than were sent. Check the message log of this send."

msgctxt "Languages::kwtsms.outcome.failed"
msgid "kwtSMS refused this send. The reason is in the log."
msgstr "kwtSMS refused this send. The reason is in the log."

msgctxt "Languages::kwtsms.outcome.unknown"
msgid "No reply after the request was sent. Check your kwtSMS archive and queue before you resend."
msgstr "No reply after the request was sent. Check your kwtSMS archive and queue before you resend."

msgctxt "Languages::kwtsms.outcome.rejected"
msgid "kwtSMS rejected this message. Review the template wording."
msgstr "kwtSMS rejected this message. Review the template wording."

msgctxt "Languages::kwtsms.outcome.invalid"
msgid "The number isn't a valid mobile number."
msgstr "The number isn't a valid mobile number."

msgctxt "Languages::kwtsms.outcome.duplicate"
msgid "The same number appears more than once in this send. It was sent once."
msgstr "The same number appears more than once in this send. It was sent once."

msgctxt "Languages::kwtsms.outcome.no_phone"
msgid "No phone number to send to."
msgstr "No phone number to send to."

msgctxt "Languages::kwtsms.outcome.no_coverage"
msgid "The country of this number isn't in your kwtSMS coverage."
msgstr "The country of this number isn't in your kwtSMS coverage."

msgctxt "Languages::kwtsms.outcome.blocked_country"
msgid "The country of this number isn't one of the allowed customer countries."
msgstr "The country of this number isn't one of the allowed customer countries."

msgctxt "Languages::kwtsms.outcome.blocked_disabled"
msgid "SMS sending is turned off in the kwtSMS settings."
msgstr "SMS sending is turned off in the kwtSMS settings."

msgctxt "Languages::kwtsms.outcome.blocked_not_configured"
msgid "kwtSMS isn't set up yet. Log in and select a Sender ID in the kwtSMS settings."
msgstr "kwtSMS isn't set up yet. Log in and select a Sender ID in the kwtSMS settings."

msgctxt "Languages::kwtsms.outcome.blocked_empty"
msgid "The message is empty after cleaning."
msgstr "The message is empty after cleaning."

msgctxt "Languages::kwtsms.outcome.blocked_too_long"
msgid "The message has more pages than allowed. Shorten the template."
msgstr "The message has more pages than allowed. Shorten the template."

msgctxt "Languages::kwtsms.outcome.blocked_placeholder"
msgid "The message still holds an unfilled placeholder. Fix the template."
msgstr "The message still holds an unfilled placeholder. Fix the template."

msgctxt "Languages::kwtsms.outcome.blocked_balance"
msgid "Not enough kwtSMS credits. Recharge your kwtSMS account."
msgstr "Not enough kwtSMS credits. Recharge your kwtSMS account."

msgctxt "Languages::kwtsms.outcome.blocked_pilot"
msgid "Pilot mode is on, so only the admin alert numbers get SMS."
msgstr "Pilot mode is on, so only the admin alert numbers get SMS."

msgctxt "Languages::kwtsms.outcome.blocked_daily_cap"
msgid "The store reached its daily SMS limit. Sending resumes tomorrow or when you resume it."
msgstr "The store reached its daily SMS limit. Sending resumes tomorrow or when you resume it."

msgctxt "Languages::kwtsms.outcome.rate_limited"

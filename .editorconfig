# FILE:      .editorconfig
# CREATED:   2026-10-20 13:27 +03
# TASK:      596
# AUTHOR:    kwtSMS
# WHAT:      Editor formatting defaults for the add-on source.
# WHY:       CS-Cart coding standards: 4-space indentation, LF, UTF-8 (needed for Arabic .po files).
# USAGE:     Picked up by editors that support EditorConfig.
# DEPENDS:   Nothing.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

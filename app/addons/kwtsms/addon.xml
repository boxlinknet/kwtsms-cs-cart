            `updated_at` int(11) unsigned NOT NULL DEFAULT 0,
            PRIMARY KEY (`company_id`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
        </item>
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_vendor_quotas` (
            `plan_id` int(11) unsigned NOT NULL DEFAULT 0,
            `monthly_limit` int(11) unsigned NOT NULL DEFAULT 0,
            PRIMARY KEY (`plan_id`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
        </item>
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_customer_prefs` (
            `user_id` int(11) unsigned NOT NULL DEFAULT 0,
            `order_sms` char(1) NOT NULL DEFAULT 'Y',
            `updated_at` int(11) unsigned NOT NULL DEFAULT 0,
            PRIMARY KEY (`user_id`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
        </item>

        <!-- 2026-10-23 15:11 +03: Task M1.1a (Phase 3 Milestone 1, data model), task 596. The code table (hash only,
             never a plain code), the rate-limit buckets (atomic counters) and the phone index (one row per account;
             verified_phone is UNIQUE and NULL while unverified). The upgrade migration (upgrades/1.2.0, Task M1.1b)
             builds exactly these definitions. -->
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_otp_codes` (
            `code_id` int(11) unsigned NOT NULL AUTO_INCREMENT,
            `purpose` varchar(16) NOT NULL DEFAULT '',
            `subject` varchar(32) NOT NULL DEFAULT '',
            `user_id` int(11) unsigned NOT NULL DEFAULT 0,
            `session_hash` char(64) NOT NULL DEFAULT '',
            `code_hash` char(64) NOT NULL DEFAULT '',
            `salt` char(32) NOT NULL DEFAULT '',
            `status` char(1) NOT NULL DEFAULT 'A',
            `created_at` int(11) unsigned NOT NULL DEFAULT 0,
            `expires_at` int(11) unsigned NOT NULL DEFAULT 0,
            `ip` varchar(45) NOT NULL DEFAULT '',
            `storefront_id` int(11) unsigned NOT NULL DEFAULT 0,
            PRIMARY KEY (`code_id`),
            KEY `purpose_subject` (`purpose`, `subject`, `status`),
            KEY `idx_created_at` (`created_at`),
            KEY `idx_user_id` (`user_id`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
        </item>
        <!-- 2026-10-23 17:15 +03: idx_user_id on kwtsms_otp_codes for the GDPR collect and anonymize queries (they filter
             on user_id; without it the DELETE scans and locks the whole table). Fix round 1, finding M3, ruling P3-R2: a

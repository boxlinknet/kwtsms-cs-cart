    <queries>
        <!-- Phase 1 tables (PRD 8). Timestamps are unsigned int (Unix UTC). DEFAULT CHARSET UTF8: the
             connection is 3-byte utf8, so 4-byte characters are removed from free text before insert. -->
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_messages` (
            `message_id` int(11) unsigned NOT NULL AUTO_INCREMENT,
            `created_at` int(11) unsigned NOT NULL DEFAULT 0,
            `source` varchar(16) NOT NULL DEFAULT '',
            `event_id` varchar(128) NOT NULL DEFAULT '',
            `receiver` varchar(15) NOT NULL DEFAULT '',
            `company_id` int(11) unsigned NOT NULL DEFAULT 0,
            `parent_order_id` int(11) unsigned NOT NULL DEFAULT 0,
            `storefront_id` int(11) unsigned NOT NULL DEFAULT 0,
            `order_id` int(11) unsigned NOT NULL DEFAULT 0,
            `user_id` int(11) unsigned NOT NULL DEFAULT 0,
            `actor_user_id` int(11) unsigned NOT NULL DEFAULT 0,
            `actor_company_id` int(11) unsigned NOT NULL DEFAULT 0,
            `sender` varchar(32) NOT NULL DEFAULT '',
            `recipients` text,
            `recipient_count` int(11) unsigned NOT NULL DEFAULT 0,
            `numbers_accepted` int(11) unsigned NOT NULL DEFAULT 0,
            `partial_accept` char(1) NOT NULL DEFAULT 'N',
            `message` text,
            `masked` char(1) NOT NULL DEFAULT 'N',
            `lang_code` char(2) NOT NULL DEFAULT '',
            `encoding` varchar(8) NOT NULL DEFAULT '',
            `pages` smallint(5) unsigned NOT NULL DEFAULT 0,
            `is_test` char(1) NOT NULL DEFAULT 'N',
            `batch_no` smallint(5) unsigned NOT NULL DEFAULT 1,
            `batch_total` smallint(5) unsigned NOT NULL DEFAULT 1,
            `status` varchar(32) NOT NULL DEFAULT '',
            `api_code` varchar(32) NOT NULL DEFAULT '',
            `code_source` varchar(8) NOT NULL DEFAULT 'api',
            `api_msg_id` varchar(64) NOT NULL DEFAULT '',
            `points_charged` decimal(14,2) unsigned NOT NULL DEFAULT 0.00,
            `balance_after` decimal(14,2) NOT NULL DEFAULT 0.00,
            `api_unix_ts` int(11) unsigned NOT NULL DEFAULT 0,
            `api_request` mediumtext,
            `api_response` mediumtext,
            `duration_ms` int(11) unsigned NOT NULL DEFAULT 0,
            PRIMARY KEY (`message_id`),
            KEY `idx_created_at` (`created_at`),
            KEY `idx_status_created_at` (`status`, `created_at`),
            KEY `idx_event_id` (`event_id`),
            KEY `idx_order_id` (`order_id`),
            KEY `idx_parent_order_id` (`parent_order_id`),
            KEY `idx_company_created_at` (`company_id`, `created_at`),
            KEY `idx_api_msg_id` (`api_msg_id`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
        </item>
        <!-- 2026-10-21 06:04 +03: kwtsms_messages.idx_api_msg_id (the Logs page finds a message by the msg-id kwtSMS
             support quotes), kwtsms_attempts.idx_message_id (the recipients of one message in the detail view) and
             idx_created_outcome_test (created_at, outcome, is_test: the Dashboard counters read the index only; 47 ms
             instead of 756 ms at 1M attempts, ruling R35 evidence); kwtsms_debug_log.idx_action gains created_at, so the
             Debug log filtered by action is read in time order and counted from the index (785 ms -> index only at 2M rows),
             Task 1.14, task 596. -->
        <!-- 2026-10-21 03:12 +03: kwtsms_attempts.is_test (Y/N, last column) is the test flag of the send, added in Task 1.11
             so the Dashboard can count skipped and deferred attempts for live and test separately (PRD 6.9); task 596. -->
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_attempts` (
            `attempt_id` int(11) unsigned NOT NULL AUTO_INCREMENT,
            `created_at` int(11) unsigned NOT NULL DEFAULT 0,
            `message_id` int(11) unsigned NOT NULL DEFAULT 0,
            `outbox_id` int(11) unsigned NOT NULL DEFAULT 0,
            `retry_of` int(11) unsigned NOT NULL DEFAULT 0,
            `source` varchar(16) NOT NULL DEFAULT '',
            `event_id` varchar(128) NOT NULL DEFAULT '',
            `receiver` varchar(15) NOT NULL DEFAULT '',
            `company_id` int(11) unsigned NOT NULL DEFAULT 0,
            `parent_order_id` int(11) unsigned NOT NULL DEFAULT 0,
            `storefront_id` int(11) unsigned NOT NULL DEFAULT 0,
            `order_id` int(11) unsigned NOT NULL DEFAULT 0,
            `user_id` int(11) unsigned NOT NULL DEFAULT 0,
            `actor_user_id` int(11) unsigned NOT NULL DEFAULT 0,
            `phone_raw` varchar(64) NOT NULL DEFAULT '',
            `phone` varchar(64) NOT NULL DEFAULT '',
            `outcome` varchar(32) NOT NULL DEFAULT '',
            `reason` varchar(255) NOT NULL DEFAULT '',
            `ip` varchar(45) DEFAULT NULL,
            `is_test` char(1) NOT NULL DEFAULT 'N',
            PRIMARY KEY (`attempt_id`),
            KEY `idx_created_at` (`created_at`),
            KEY `idx_phone_created_at` (`phone`, `created_at`),
            KEY `idx_ip_created_at` (`ip`, `created_at`),
            KEY `idx_outcome_created_at` (`outcome`, `created_at`),
            KEY `idx_order_id` (`order_id`),
            KEY `idx_parent_order_id` (`parent_order_id`),
            KEY `idx_message_id` (`message_id`),
            KEY `idx_created_outcome_test` (`created_at`, `outcome`, `is_test`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
        </item>
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_debug_log` (
            `log_id` int(11) unsigned NOT NULL AUTO_INCREMENT,
            `created_at` int(11) unsigned NOT NULL DEFAULT 0,
            `level` varchar(10) NOT NULL DEFAULT 'info',
            `action` varchar(64) NOT NULL DEFAULT '',
            `message` text,
            `context` text,
            `duration_ms` int(11) unsigned NOT NULL DEFAULT 0,
            `request_id` varchar(32) NOT NULL DEFAULT '',
            `user_id` int(11) unsigned NOT NULL DEFAULT 0,
            PRIMARY KEY (`log_id`),
            KEY `idx_created_at` (`created_at`),
            KEY `idx_level_created_at` (`level`, `created_at`),
            KEY `idx_action` (`action`, `created_at`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
        </item>
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_templates` (
            `template_id` int(11) unsigned NOT NULL AUTO_INCREMENT,
            `event_id` varchar(128) NOT NULL DEFAULT '',
            `receiver` varchar(15) NOT NULL DEFAULT '',
            `updated_at` int(11) unsigned NOT NULL DEFAULT 0,
            `storefront_id` int(11) unsigned NOT NULL DEFAULT 0,
            PRIMARY KEY (`template_id`),
            UNIQUE KEY `uniq_event_receiver_sf` (`event_id`, `receiver`, `storefront_id`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
        </item>
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_template_descriptions` (
            `template_id` int(11) unsigned NOT NULL DEFAULT 0,
            `lang_code` char(2) NOT NULL DEFAULT '',
            `body` text,
            `is_edited` char(1) NOT NULL DEFAULT 'N',
            PRIMARY KEY (`template_id`, `lang_code`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
        </item>
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_brand_names` (
            `storefront_id` int(11) unsigned NOT NULL DEFAULT 0,
            `enabled` char(1) NOT NULL DEFAULT 'Y',
            `sender_id` varchar(11) NOT NULL DEFAULT '',
            PRIMARY KEY (`storefront_id`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
        </item>
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_brand_name_descriptions` (
            `storefront_id` int(11) unsigned NOT NULL DEFAULT 0,
            `lang_code` char(2) NOT NULL DEFAULT '',
            `brand_name` varchar(64) NOT NULL DEFAULT '',
            PRIMARY KEY (`storefront_id`, `lang_code`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
        </item>
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_outbox` (
            `outbox_id` int(11) unsigned NOT NULL AUTO_INCREMENT,
            `created_at` int(11) unsigned NOT NULL DEFAULT 0,
            `retry_at` int(11) unsigned NOT NULL DEFAULT 0,
            `expires_at` int(11) unsigned NOT NULL DEFAULT 0,
            `attempts` smallint(5) unsigned NOT NULL DEFAULT 0,
            `reason` varchar(32) NOT NULL DEFAULT '',
            `status` varchar(16) NOT NULL DEFAULT 'pending',
            `phones` text,
            `message` text,
            `context` mediumtext,
            `has_secret` tinyint(1) unsigned NOT NULL DEFAULT 0,
            PRIMARY KEY (`outbox_id`),
            KEY `idx_status_retry_at` (`status`, `retry_at`),
            KEY `idx_status_secret_expires` (`status`, `has_secret`, `expires_at`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
            <!-- 2026-10-24 16:20 +03: Task M1.5 fix round 1 (M-B), task 596. has_secret = 1 while the row holds a code or other
                 secret; Outbox::selectStale() finds expired secret rows through idx_status_secret_expires instead of a
                 leading-wildcard LIKE on context (2 s on 200k rows with 900-byte contexts). -->
        </item>
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_dispatch_keys` (
            `dispatch_key` varchar(191) NOT NULL,
            `created_at` int(11) unsigned NOT NULL DEFAULT 0,
            PRIMARY KEY (`dispatch_key`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
        </item>

        <!-- 2026-10-22 13:13 +03: Milestone A (1.1.0) columns and tables, Task A1, task 596 (PRD 8 amended):
             kwtsms_templates.storefront_id (0 = all storefronts) with uniq_event_receiver_sf replacing uniq_event_receiver,
             kwtsms_brand_names.sender_id ('' = the global Sender ID), and the four tables below. The upgrade migration
             (upgrades/1.1.0/migrations) builds exactly these definitions on an existing 1.0.0 store; a test compares
             SHOW CREATE TABLE of both paths. -->
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_storefront_switches` (
            `storefront_id` int(11) unsigned NOT NULL DEFAULT 0,
            `event_id` varchar(128) NOT NULL DEFAULT '',
            `receiver` varchar(15) NOT NULL DEFAULT '',
            `enabled` char(1) NOT NULL DEFAULT 'N',
            `updated_at` int(11) unsigned NOT NULL DEFAULT 0,
            PRIMARY KEY (`storefront_id`, `event_id`, `receiver`)
            ) ENGINE=InnoDB DEFAULT CHARSET UTF8;
        </item>
        <item>
            CREATE TABLE IF NOT EXISTS `?:kwtsms_vendor_phones` (
            `company_id` int(11) unsigned NOT NULL DEFAULT 0,
            `phone` varchar(32) NOT NULL DEFAULT '',
